! NO VT reaction
! NO is analogous to O2
! SSH theory and approximations for the Morse oscillator model.
! M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
! A. Starikovskiy and N. Aleksandrov, Prog. Energy Combust. Sci. 39 (1) (2013) 61-110.
! Xingqian Mao, et al. Combust. Flame 259 (2024) 113140.
! kVT10_O2N2 = exp(-28.02d0-132.0d0/Tgas**(1.0d0/3.0d0))
!Fit to Arrhenius formula at 300-400K with an error of 10%
NO(V1) + N2 => NO + N2          4.08E+11        0.0      0.0         !
LT / -132.00   0.0/
NO(V2) + N2 => NO(V1) + N2      8.22E+11        0.0      0.0         ! 
LT / -129.73   0.0/
NO(V3) + N2 => NO(V2) + N2      1.24E+12       0.0       0.0         ! 
LT / -127.45   0.0/
NO(V4) + N2 => NO(V3) + N2      1.67E+12       0.0       0.0         ! 
LT / -125.18   0.0/
NO(V5) + N2 => NO(V4) + N2      2.10E+12       0.0       0.0         ! 
LT / -122.91   0.0/

! kVT10_O2O2 = exp(-18.32d0-157.0d0/Tgas**(1.0d0/3.0d0))
!Fit to Arrhenius formula at 300-400K with an error of 10%
NO(V1) + O2 => NO + O2         6.66E+15       0.0       0.0           !
LT / -157.00   0.0/
NO(V2) + O2 => NO(V1) + O2     1.34E+16       0.0     0.0          !
LT / -154.68   0.0/
NO(V3) + O2 => NO(V2) + O2     2.03E+16      0.0     0.0          ! 
LT / -152.35   0.0/
NO(V4) + O2 => NO(V3) + O2     2.72E+16    0.0      0.0          !   
LT / -150.03   0.0/
NO(V5) + O2 => NO(V4) + O2     3.43E+16    0.0      0.0          ! 
LT / -147.70   0.0/

!kVT10_O2O = Tgas*exp(-28.87d0-111.0d0/Tgas**(1.0d0/3.0d0)) 
!Fit to Arrhenius formula at 300-400K with an error of 10%
NO(V1) + O => NO + O       1.74E+11      1.0     0.0               !
LT / -111.00   0.0/
NO(V2) + O => NO(V1) + O   3.51E+11      1.0     0.0               ! 
LT / -108.96   0.0/
NO(V3) + O => NO(V2) + O   5.30E+11      1.0     0.0             ! 
LT / -106.92   0.0/
NO(V4) + O => NO(V3) + O   7.12E+11     1.0     0.0             ! 
LT / -104.89   0.0/
NO(V5) + O => NO(V4) + O   8.97E+11     1.0     0.0             ! 
LT / -102.85   0.0/


! M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
! NO is analogous to O2
! KVT_O2AR=3.14E13*T^1.0*EXP(-137.9/T^(1/3)+6.2E5/T^2)*EXP(1-1*EXP(-2272/T)^-1)*6.022E+23
! NO(V1) are *5
! NO(V2) calculated as Schwartz-Slawsky-Herzfeld (SSH) theory
! Fit at 300-400K with an error of 5%
NO(V1) + AR => NO + AR         2.90E+5        0.8      -1300            ! 
NO(V2) + AR => NO(V1) + AR     1.350E+5       0.8      -1300            !
NO(V3) + AR => NO(V2) + AR     0.950E+5       0.8      -1300            !
NO(V4) + AR => NO(V3) + AR     0.660E+5       0.8      -1300            ! 
NO(V5) + AR => NO(V4) + AR     0.475E+5       0.8      -1300            ! 

! M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
! NO is analogous to O2
! KVT_O2O2=1.35E-12*T^1.0*EXP(-137.9/T^(1/3)+0/T^0)*EXP(1-1*EXP(-2272/T)^-1)*6.022E+23
! NO(V1) cited by Book 2000
! NO(V2) calculated as Schwartz-Slawsky-Herzfeld (SSH) theory
! Fit at 300-400K with an error of 10%
NO(V1) + NO => NO + NO       5.28E+3      1.87      4000           ! 
NO(V2) + NO => NO(V1) + NO   3.8E+3      1.87      4000            !  
NO(V3) + NO => NO(V2) + NO   2.8E+3      1.87      4000            !
NO(V4) + NO => NO(V3) + NO   2.01E+3      1.87      4000           ! 
NO(V5) + NO => NO(V4) + NO   1.48E+3      1.87      4000           ! 



! NO (V) V-V relaxation 
! NO is analogous to CO
! Mao X.Q. Ignition enhancement and NOx formation of NH3/air mixtures by non-equilibrium plasma discharge. Combustion and Flame 2024
! Kvv_O2O2=1.04E+6*T^1.5
! Kvv_NONO=A*T^b*exp(C/T^0.5)                      
!Fit to Arrhenius formula at 300-700K with an error of 5%
NO(V1)+NO(V1)=>NO+NO(V2)         4.60E+07       1.07        120    !
NO(V1)+NO(V2)=>NO+NO(V3)         9.40E+07       1.07        100    !
NO(V1)+NO(V3)=>NO+NO(V4)         1.60E+08       1.07        30     !
NO(V1)+NO(V4)=>NO+NO(V5)         1.10E+09       0.85        50     !

NO(V2)+NO=>NO(V1)+NO(V1)         4.60E+07       1.07        120    !
NO(V2)+NO(V2)=>NO(V1)+NO(V3)     2.40E+08       1.0         200    !
NO(V2)+NO(V3)=>NO(V1)+NO(V4)     2.80E+08       1.07        188    !
NO(V2)+NO(V4)=>NO(V1)+NO(V5)     6.20E+08       1.00        30     !

NO(V3)+NO=>NO(V2)+NO(V1)         9.40E+07       1.07        100    !
NO(V3)+NO(V1)=>NO(V2)+NO(V2)     2.40E+08       1.0         200    !
NO(V3)+NO(V3)=>NO(V2)+NO(V4)     2.50E+08       1.1         150    ! 
NO(V3)+NO(V4)=>NO(V2)+NO(V5)     5.20E+08       1.07        160    !

NO(V4)+NO=>NO(V3)+NO(V1)         1.60E+08       1.07        30     !
NO(V4)+NO(V1)=>NO(V3)+NO(V2)     2.80E+08       1.07        188    !
NO(V4)+NO(V2)=>NO(V3)+NO(V3)     2.50E+08       1.1         150    !
NO(V4)+NO(V4)=>NO(V3)+NO(V5)     2.40E+08       1.18        100    !

NO(V5)+NO=>NO(V4)+NO(V1)         1.10E+09       0.85        50     !
NO(V5)+NO(V1)=>NO(V4)+NO(V2)     6.20E+08       1.00        30     !
NO(V5)+NO(V2)=>NO(V4)+NO(V3)     5.20E+08       1.07        160    !
NO(V5)+NO(V3)=>NO(V4)+NO(V4)     2.40E+08       1.18        100    !

! Chemical reaction of NO(E)
! MMVT theroy
! Starik A., Sharipov A., 2011. Theoretical analysis of reaction kinetics with singlet oxygen molecules. Phys. Chem. Chem. Phys. 13, 16424 C16436. 
!NO+N=N2+O                     4.94E+13	      0.0             8.15E+02     ! 	Clyne, M.A.A.; McDermid, I.S. 1975CLY/MCD2189
NO(E1)+N=>N2+O                 4.94E+13	      0.0             9.090E+04         
NO(E2)+N=>N2+O                 4.94E+13	      0.0             8.393E+04

!NO+O=O2+N                     5.38E+11	      1.00            3.870E+04      ! 	1991TSA/HER609-663 NIST 200-2500K
NO(E1)+O=>O2+N                 5.38E+11	      1.00            1.786E+04         
NO(E2)+O=>O2+N                 5.38E+11	      1.00            1.676E+04

!N2O+NO=NO2+N2                 5.300E+05       2.20           4.628E+04 ! Mebel et al.;IJCK 1996, 28, 693-703 also used by Tian 2009/KLIMIC2011/Zhang 2011
NO(E1)+N2O=>NO2+N2             5.300E+05       2.2            5.992E+04   
NO(E2)+N2O=>NO2+N2             5.300E+05       2.2            5.409E+04

! NO+NO=N2+O2                  3.000E+11       0.0            6.50E+04! 01KON/DER1   Konnov 2023
NO(E1)+NO=>N2+O2               3.000E+11       0.000          1.644E+04
NO(E2)+NO=>N2+O2               3.000E+11       0.000          1.466E+04

! NO(E) is analogous to O2(a1) and O2(b1)
! Quenching of excited states of O2
! reactions of O2(a1)
! M. Capitelli, et al, Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York.
! N. Liu, H. Chen, M. Zhang, Q. Chen, X. Jiang, B. Yang,  Combust. Flame 267 (2024) 113571.
NO(E1) + O => NO + O              4.22E+08        0.0     0.0                 ! 7.00d-16
NO(E1) + N => NO + N              1.20E+10        0.0     1.19E+03            ! 2.00d-14*exp(-600.0d0/Tgas)
NO(E1) + O2 => O2 + NO            2.29E+06        0.0     4.07E+02            ! 3.80d-18*exp(-205.0d0/Tgas)
NO(E1) + N2 => NO + N2            1.81E+03        0.0     0.0       ! 3.00d-21
NO(E1) + NO => NO + NO            1.51E+13        0.0     0.0       ! 2.50d-11
NO(E1) + NO(E1) => NO + NO(E2)    4.22E-04        3.8     -1.39E+03            ! 7.00d-28*Tgas**3.8*exp(700.0d0/Tgas) 

! NO(E) is analogous to O2(a1) and O2(b1)
! A. Hicks et al, J. Phys. D: Appl. Phys. 38 (20) (2005) 3812-3824.
NO(E1) + O + NO => NO(E1) + O + NO      6.02E-09         0.0           0.0         ! 1.00d-32
! NO(E) is analogous tos O2(a1) and O2(b1)
! A. Starikovskiy, N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
NO(E1) + O => NO(E2) + O          4.82E+10       0.0         1.52E+04      ! 8.00d-14*exp(-7660.0d0/Tgas)
NO(E1) + O2 => NO(E2) + O2        9.03E+07       0.0         1.52E+04      ! 1.50d-16*exp(-7660.0d0/Tgas)
NO(E1) + N2 => NO(E2) + N2        1.39E+09       0.0         1.52E+04      ! 2.30d-15*exp(-7660.0d0/Tgas)
NO(E1) + NO => NO(E2) + NO        3.01E+09       0.0         1.52E+04      ! 5.00d-15*exp(-7660.0d0/Tgas)
NO(E1) + NO(E1) => NO + NO        7.53E+08       0.0         2.34E+03      ! 1.25d-15*exp(-1180.0d0/Tgas)

! NO(E) is analogous to O2(a1) and O2(b1)
! reactions of O2(b1)
! M. Capitelli, et al, Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York.
NO(E2) + O => NO(E1) + O         4.88E+10      0.0     0.0             ! 8.10d-14
NO(E2) + O2 => NO(E1) + O2       2.59E+02      2.4     5.58E+02        ! 4.30d-22*Tgas**2.4*exp(-281.0d0/Tgas)
NO(E2) + N2 => NO(E1) + N2       3.41E+06      1.0     0.0             ! 1.70d-15*(Tgas/300.0d0)
NO(E2) + NO => NO(E1) + NO       3.61E+10      0.0     0.0             ! 6.00d-14

! NO(E) is analogous to O2(a1) and O2(b1)
! W. Van Gaens, A. Bogaerts, J. Phys. D: Appl. Phys. 46 (2013) 275201.
NO(E2) + O => NO + O             4.82E+09      0.5     0.0             ! 8.00d-15*Tgas**0.5
NO(E2) + NO(E2) =>  NO(E1) + NO  2.17E+07      0.5     0.0             ! 3.60d-17*Tgas**0.5  

! NO(E) is analogous to O2(a1) and O2(b1)
! A. Starikovskiy, N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
NO(E2) + O2 => NO + O2           2.41E+07      0.0    0.0             ! 4.00d-17
NO(E2) + N2 => N2 + NO           1.39E+09      0.0    0.0             ! 2.30d-15

! NO(E) is analogous to O2(a1) and O2(b1)
!optical transitions and predissociation 
! M. Capitelli, et al, Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York.
NO(E1)=>NO                       1.57E+20      0.0      0.0                          ! 2.6d-4
NO(E2)=>NO(E1)                   9.03E+20      0.0      0.0                          ! 1.5d-3
NO(E2)=>NO                       5.12E+22      0.0      0.0                          ! 8.5d-2

! Positive ion reactions
! Reactions of NO^+
! A. Starikovskiy, N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
NO^+ + N + N2 => N2^+ + N2O       7.47E+07           0.0             3.298E+04       ! 1.24E-16*exp(-16600.0d0/Tgas)
! KIDA, kinetic database for astrochemistry
NO^+ + E => N + O         2.14E+18            -0.37              0.0            ! 4.30E-07*(300.0d0/Te)**0.37
TDEP/E/

! Anthony C. DeFilipo,Combustion and Flame, 172 (2016) 38-48.
N2^+ + E + E => N2 + E     1.76E+16            -4.50              0.0            ! 2.08E-19*(300.0d0/Te)**4.5
! A. Starikovskiy, N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.

NO^+ + E + N2 => NO + N2   5.63E+03             -2.50              0.0            ! 9.35E-21/Te**2.5
TDEP/E/
NO^+ + E + O2 => NO + O2   5.63E+03             -2.50              0.0            ! 9.35E-21/Te**2.5
TDEP/E/


