!---------------------------------------------------------------------------------------------------------------------------------------------
!----------------------------------Supplementary Material-------------------------------------------------------------------------------
! Direct NO removal driven by dielectric barrier discharge: An experimental and kinetic modeling study
! Menglei Zheng, Yong Bao, Xianhui Chen*, Xiaoyuan Zhang*
! Contanct: xiaoyuanzhang@ustc.edu.cn
!---------------------------------------------------------------------------------------------------------------------------------------------
!---------------------------------------------------------------------------------------------------------------------------------------------


ELEMENTS
N     O     AR    E
END

SPECIES
! Neutral species
O         O2       O3          
N         N2 
NO        NO2                  
NO3       N2O
AR   

! Excited species       	   	          
AR*       
NO(V1)     NO(V2)     NO(V3)      NO(V4)     NO(V5) 
NO(E1)     NO(E2) 

! Charged species
N2^+       O2^+  
NO^+       AR^+  
E
    
END

REACTIONS

!-----------------------------------------------------------------------
!
!  plasma chemistry
!
!-----------------------------------------------------------------------

!-----------------------------------------------------------------------
!
!  BOLSIG+  Electronic collision reaction
!
!-----------------------------------------------------------------------

!Electronic excitation
!Phelps database
E + AR => E+ AR*                        f(E/N)              ! BOLSIG AR -> AR*
E + AR => E + E + AR^+                  f(E/N)              ! BOLSIG AR -> AR^+ 
!#Morgan database
!#www.lxcat.net
E + NO => E + NO(V1)                    f(E/N)              ! BOLSIG NO -> NO(V1)
E + NO => E + NO(V2)                    f(E/N)              ! BOLSIG NO -> NO(V2)
E + NO => E + NO(V3)                    f(E/N)              ! BOLSIG NO -> NO(V3)
E + NO => E + NO(V4)                    f(E/N)              ! BOLSIG NO -> NO(V4)
E + NO => E + NO(V5)                    f(E/N)              ! BOLSIG NO -> NO(V5)
E + NO => E + NO(E1)                    f(E/N)              ! BOLSIG NO -> NO(e1)(5.45eV)
E + NO => E + NO(E2)                    f(E/N)              ! BOLSIG NO -> NO(e2)(6.58eV)
E + NO => E + E + NO^+                  f(E/N)              ! BOLSIG NO -> NO^+


!----------------------------------------------------------------------- 
!
!  AR submech
!
!-----------------------------------------------------------------------

!C. Lee and M. A. Lieberman.Journal of Vacuum Science & Technology A 13, 368 (1995)
!NO is analogous to O2
AR* + NO => AR + N + O                3.49E+13      0.0          0.0     !5.8E-11
!C. Lee and M. A. Lieberman.Journal of Vacuum Science & Technology A 13, 368 (1995)
AR* + O2 => AR + O2                    6.74E+14           0.0             0.0     ! 1.12E-9
! A. Starikovskiy, N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
! NO is analogous to O2
AR^+ + NO => NO^+ + AR         3.43E+13     0.0      0.0             ! 5.7d-11
!  Electron-ion recombination
! C. Yao, et al., Phys. Plasmas 24 (2017) 093505.
E + E + AR^+ => E + AR*        3.01E-03    -4.5       0.0           !  5.0d-27/Te**4.5
TDEP/E/

