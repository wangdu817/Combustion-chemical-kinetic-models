REACTIONS

!**********************************************************************!
!**********************************************************************!
!*             Primary mechanism of the oxidation of furan            *!
!**********************************************************************!
!**********************************************************************!

!****************************************************!
!* Reactions of furan                               *!
!****************************************************!

!**unimolecular initiation
!*rupture of C-C and C-H
furan=CH2CCHCHO        6.04E58  -13.388  94.049E3!Prof.Fournet low pressure 0.047 bar
furan=C2H2+CH2COZ     3.75E73  -17.412  113.325E3 !Prof.Fournet low pressure 0.047 bar

! by analogy with c-C5H10 TSA78!
R1H+furyl-2=furan      1.0E14    0.0  0.0  ! Est.
R1H+furyl-3=furan      1.0E14    0.0  0.0  ! Est.

!**bimolecular initiation
furan+O2=furyl-2+R3OOH   2.0E13  0.0  70.68E3 ! A-I-3 secondary A*2!corrected by RF!
furan+O2=furyl-3+R3OOH   2.0E13  0.0  70.88E3 ! A-I-3 secondary A*2!corrected by RF!

!**reaction with H atoms
furan+R1H=C4H5O-2               2.6E13     0     3.2E3! as C4H6Z2+R1H=C4H7-1
furan+R1H=C4H5O-3               2.6E13     0     1.56E3! as C4H6Z2+R1H=C4H7Y

!**reaction with OH atoms
furan+R2OH=C2H3CHO+R5CHO       2.74E12  0.0  -1.04E3!Table A-I-5

methylfuran+R1H=furan+R4CH3   5.0E14  0.0  8.0E3 !Lifshitz97

!**metatheses
!*metatheses with abstraction of H-atom

furan+R1H=furyl-2+H2     8.2E5   2.5   12.28E3   !A-I-20 secondary A*2
furan+R1H=furyl-3+H2     8.2E5   2.5   12.28E3   !A-I-20 secondary A*2

furan+B1O=furyl-2+R2OH   1.2E11   0.7   8.96E3   !A-I-20 secondary A*2
furan+B1O=furyl-3+R2OH   1.2E11   0.7   8.96E3   !A-I-20 secondary A*2

furan+R2OH=furyl-2+H2O   2.2E6   2.0   2.78E3  !A-I-20 secondary A*2
furan+R2OH=furyl-3+H2O   2.2E6   2.0   2.78E3  !A-I-20 secondary A*2

!furan+R3OOH=>furyl-2+H2O2   1.724E6   2.0   10.38E3  !Ranzi08 furan+R3OOH=>furyl+H2O2
!furan+R3OOH=>furyl-3+H2O2   1.724E6   2.0   10.38E3  !Ranzi08 furan+R3OOH=>furyl+H2O2

!furan+R5CHO=>furyl-2+HCHO   4.042E6   2.0   10.67E3  !Ranzi08 furan+R5CHO=>furyl+HCHO
!furan+R5CHO=>furyl-3+HCHO   4.042E6   2.0   10.67E3  !Ranzi08 furan+R5CHO=>furyl+HCHO

furan+R4CH3=furyl-2+CH4   1.36   3.5   12.9E3  !A-I-20 secondary A*2
furan+R4CH3=furyl-3+CH4   1.36   3.5   12.9E3  !A-I-20 secondary A*2


!*******************************************************!
!* Reactions of furyl radicals                         *!
!*******************************************************!

!isomerization
furyl-3=furyl-2                1.5E13    0.0    67.8E3 !as  iC4H5=nC4H5 <LEUnG95>!

!reaction with O2
furyl-2+O2=CH2CHCO+CO2        4.5E16     -1.39    1.0E3 !O2+R10C2H3V=HCHO+R5CHO  !(266a,-266a)<MEBEL nIST>!
furyl-2+O2=CHCHCHO+B2CO+B1O   3.3E11     -0.29      10. !O2+R10C2H3V=B1O+R13CH2CHO(266b,-266b)<MEBEL nIST>!
furyl-3+O2=CH2CHCO+CO2        4.5E16     -1.39    1.0E3 !O2+R10C2H3V=HCHO+R5CHO  !(266a,-266a)<MEBEL nIST>!
furyl-3+O2=C2H2+R5CHO+B2CO+B1O   3.3E11     -0.29      10. !O2+R10C2H3V=B1O+R13CH2CHO(266b,-266b)<MEBEL nIST>!

!reaction with O
furyl-2+B1O=CHCHCHO+B2CO      3.0E13      0.         0.  !B1O+R10C2H3V=CH2COZ+R1H  !RAS/GLA08b
furyl-3+B1O=C2H2+R5CHO+B2CO   3.0E13      0.         0.  !B1O+R10C2H3V=CH2COZ+R1H  !RAS/GLA08b

!B1O+R10C2H3V=R4CH3+B2CO        3.0E13      0.         0. !(66,-66)<DAGAUT91>!

!**bete-scission decomposition
furyl-2=CHCHCHCO               1.81E13   0.341  34.511E3  !calculated by Prof. Fournet high pressure
furyl-3=CHCCHCHO               1.05E13   0.306  31.215E3  ! calculated by Prof. Fournet high pressure


!*******************************************************!
!* Reactions of C4H5O and derived radicals             *!
!*******************************************************!

C4H5O-2=C4H5O-3                 3.34E09   1.0    39.1E3 ! as   C4H7-1=C4H7Y

C4H5O-2=C2H2+R13CH2CHO          8.11E12  0.246  34.925E3  !calculated by Prof. Fournet high pressure
C4H5O-3=CH2CHCHCHO              1.05E13  0.085  22.555E3  !calculated by Prof. Fournet high pressure

C4H5O-2+O2=R3OOH+furan          2.6E11   0.0  2.5E3!similar to C5H7#+O2=C5H6#+R3OOH  A/2
C4H5O-3+O2=R3OOH+furan          1.58E12  0.0  15.2E3!similar to C5H7#Y+O2=C5H6#+R3OOH

C4H5O-2+B1O=C2H3CHO+R5CHO       5.5e13      0.         0.!B1O+R11C2H5=CH3CHO+R1H
C4H5O-3+B1O=C2H2+HCHO+R5CHO     5.5e13      0.         0.!B1O+R11C2H5=CH3CHO+R1H
!B1O+R11C2H5=CH3CHO+R1H         5.5e13      0.         0. !(74,-74)<BAULCH94>!

C4H5O-2+R1H=furan23H            1.0E14   0.0   0.0!Est.
C4H5O-3+R1H=furan23H            1.0E14   0.0   0.0!Est.
C4H5O-3+R1H=furan25H            1.0E14   0.0   0.0!Est.

CH2CHCHCHO=CHCHCHCHOH           2.20E11  0.435  35.127E3  !calculated by Prof. Fournet high pressure
CH2CHCHCHO=B2CO+C3H5Y           4.85E12  0.261  47.443E3  !calculated by Prof. Fournet high pressure
CHCHCHCHOH=C2H2+R13CH2CHO       1.20E15  0.102  48.75E3  !calculated by Prof. Fournet high pressure

CH2CHCHCHO+R1H=CH2CHCH2CHO      1.0E14  0.0  0.0    !est.
CH2CHCHCHO+R4CH3=C5H8O          1.5E13  0.0  0.0    !est.

 
!*******************************************************!
!* Reactions of C4H3O radicals                         *!
!*******************************************************!
CHCHCHCO=C2H2+R12CHCOZ         5.30E15  -0.234  34.234E3 !calculated by Prof. Fournet high pressure
CHCHCHCO=CHCCHCO+R1H           8.72E11  0.706  38.68E3 !calculated by Prof. Fournet high pressure
CHCCHCHO=B2CO+C3H3             1.46E12  0.345  48.401E3 !calculated by Prof. Fournet high pressure
CHCCHCHO=CHCCHCO+R1H           1.03E12  0.725  51.949E3 !calculated by Prof. Fournet high pressure

CHCCHCHO+R1H=CHCCH2CHO         1.0E14  0.0  0.0    !est.
CHCCHCHO+R4CH3=C5H6O           1.5E13  0.0  0.0    !est.

!*******************************************************!
!* Reactions of CHCHCHO radicals                         *!
!*******************************************************!
CHCHCHO+R1H=C2H3CHO    1.0E14   0.0   0.0
C2H2+R5CHO=CHCHCHO     6.0E11  0.0  7.7E3 !R4CH3+C2H2=sC3H5    6.0E11   0.0   7.7E3 !<BAULCH94>!



!**********************************************************************!
!**********************************************************************!
!*              Second mechanism of the oxidation of furan            *!
!**********************************************************************!
!**********************************************************************!

!*******************************************************!
!* Reactions of CH2CCHCHO       *!
!*******************************************************!

CH2CCHCHO=R5CHO+C3H3  3.59E14  0.0  69.88E3 !Sendt2000 A/2.2
CH2CCHCHO=B2CO+pC3H4  7.96E62  -15.352  64.415E3 !Prof.Fournet 0.047bar

!*******************************************************!
!* Reactions of methylfuran and dirived radicals       *!
!*******************************************************!

methylfuran=C4H6-2+B2CO     2.25E15  0.0  85.1E3 !Lifshitz97
methylfuran=C4H6Z2+B2CO     3.5E15  0.0  79.5E3 !Lifshitz97
methylfuran=C4H6-12+B2CO    4.5E15  0.0  85.1E3 !Lifshitz97
methylfuran=C4H6-1+B2CO     2.8E15  0.0  79.5E3 !Lifshitz97

methylfuran=pC3H4+CH2COZ      5.75E15  0.0  82.9E3 !Lifshitz97
methylfuran=C2H2+C2H4Z+B2CO   1.7E15  0.0  79.5E3  !Lifshitz97
methylfuran=R14CH3CO+C3H3     4.0E16  0.0  90.5E3  !Lifshitz97
methylfuran=R5CHO+nC4H5       4.0E16  0.0  106.0E3 !Lifshitz97

methylfuran+O2=furylCH2+R3OOH   2.18E7   2.5  46.045E3  !as toluene+O2 <Oehlschlaeger06-1> in Sakai07
methylfuran=furylCH2+R1H        1.6E16  0.0  86.0E3  !Lifshitz97
methylfuran+R1H=furylCH2+H2     3.0E14  0.0   9.0E3  !Lifshitz97
methylfuran+B1O=furylCH2+R2OH   6.0E10   0.7   7.632E3  !as toluene+B1O <Pitz01> in Sakai07
methylfuran+R2OH=furylCH2+H2O   6.45E6   2.0   0.447E3	!as toluene+R2OH MM1990KNI/KOC1375
methylfuran+R3OOH=furylCH2+H2O2 7.0E2    3.0   12.00E3	!as toluene+R3OOH MM
methylfuran+R4CH3=furylCH2+CH4       1.5E12  0.0  10.0E3  !Lifshitz97
methylfuran+R10C2H3V=furylCH2+C2H4Z  2.21E0    3.5   4.68E3  !as toluene+R10C2H3V <Pitz01>!in Sakai07
methylfuran+C3H3=furylCH2+pC3H4      8.0E11  0.0  10.0E3  !Lifshitz97
methylfuran+C3H5Y=furylCH2+C3H6Y     8.0E11  0.0  12.0E3  !Lifshitz97
methylfuran+iC4H3=furylCH2+C4H4      8.0E11  0.0   8.0E3  !Lifshitz97


!furylCH2=B2CO+C4H5       4.0E15  0.0  64.0E3 !Lifshitz97
furylCH2=B2CO+nC4H5       2.25E15  0.0  71.0E3 !Lifshitz97
furylCH2=CH2COZ+C3H3      2.25E15  0.0  64.0E3 !Lifshitz97
furylCH2=R5CHO+C4H4       2.25E15  0.0  64.0E3 !Lifshitz97
furylCH2=C2H2+R10C2H3V+B2CO   3.29E15  0.0  76.7E3 !Lifshitz97

furylCH2+O2=furylCH2O+B1O   6.3E12   0.0   40.0E3 !benzyl+O2=C6H5CH2O+B1O !<BREZINSKY84>! in Lindstet96 and Bounaceur05
furylCH2+B1O=furyl-2+HCHO   1.58E14  0.0   0.0	!benzyl+B1O=C6H5CHO+R1H	 !Brezinsky84 in Dagaut02
furylCH2O=furyl-2+HCHO      2.0E13   0.0   27.5E3 !C6H5CH2O=C6H5#+HCHO !<estimated(j)>! ACCELERE

!*******************************************************!
!* Reactions of furan23H and its derived radicals     *!
!*******************************************************!        
furan23H+O2=C4H5O-2+R3OOH   1.4E13    0.0     47.6E3   !Ingham 94!C5H8#+O2=C5H7#+R3OOH
furan23H+O2=C4H5O-3+R3OOH   1.4E12    0.0     35.6E3   !Ingham 94!A/2  C5H8#+O2=C5H7#Y+R3OOH
       
furan23H+R1H=C4H5O-2+H2  9.0E06    2.0   5000  !BUDA05 C5H8#+R1H=C5H7#+H2
furan23H+R1H=C4H5O-3+H2  5.4E04    2.5   -1900 !HEYBERGER02 A/2 C5H8#+R1H=C5H7#Y+H2       

furan23H+B1O=C4H5O-2+R2OH   2.6E13   0.0   5200    !BUDA05 C5H8#+B1O=C5H7#+R2OH    
furan23H+B1O=C4H5O-3+R2OH   8.8E10   0.7   3250    !HEYBERGER02 A/2  C5H8#+B1O=C5H7#Y+R2OH

furan23H+R2OH=C4H5O-2+H2O   2.6E06  2.0   -770    !BUDA05 C5H8#+R2OH=C5H7#+H2O    
