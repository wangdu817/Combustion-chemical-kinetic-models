!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
!--- TMM unimolecular pyrolysis
!
!    MESS Input file, execute with following code
!    MESS code: https://tcg.cse.anl.gov/papr/codes/mess.html
!    MESS lit.: https://doi.org/10.1021/jp4060704
!
!	W -> P1		TS1			92.8
!	W -> P2a	TS2a			90.6
!	W -> P2b	TS2b			71.7
!	W -> P3		TS3			96.4
!	W -> P4		TS4			96.5
!	W -> P5		TS5			57.8
!
!	W	=	TMM			0.0
!	P1	=	DMM-R3 + CH3O		92.8
!	P2a	=	RO* + CH3		90.6
!	P2b	=	MF + DME		-2.9
!	P3	=	Rt + H			96.4
!	P4	=	Rnt + H			96.5
!	P5	=	CH3OH + CH3OCOCH3	39.4
!	
!***************************************************
!               GLOBAL SECTION
!***************************************************
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
TemperatureList[K]                      1000 1200 1400 1600 1800 2000
PressureList[bar]                       0.001 0.005 0.01 0.05 0.1 0.2 0.5 1 10 100
EnergyStepOverTemperature		.2
ExcessEnergyOverTemperature		30
ModelEnergyLimit[kcal/mol]		400
CalculationMethod			direct
WellCutoff				10
ChemicalEigenvalueMax			0.8
!
MicroRateOutput                         micro.out
MicroEnerMax[kcal/mol]                  100
MicroEnerMin[kcal/mol]                  0
MicroEnerStep[kcal/mol]                 1.0
!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!***************************************************
!               MODEL SECTION
!***************************************************
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
Model
OutputTemperatureMin[K]                 10
OutputTemperatureStep[K]                10
OutputTemperatureSize                   300
EnergyRelaxation
	Exponential
!		Factor[1/cm]		85	! Kr (based on low-presure limit data)
		Factor[1/cm]		150
		Power			0.85
		ExponentCutoff		10
	End
! Kr via Tee et al., Ind.Eng.Chem.Fundamen.5(1966),356-363
! Ar via Hippler et al., J.Chem.Phys.78(1983),6709
! TMM via RMG
CollisionFrequency
LennardJones
	! M = Kr
	Epsilons[K]		165.02	697.7
	Sigmas[angstrom]	3.721	5.46
	Masses[amu]		83.798	106.121
	! M = Ar
!	Epsilons[K]		114	697.7
!	Sigmas[angstrom]	3.47	5.46
!	Masses[amu]		39.95	106.121
End
!
