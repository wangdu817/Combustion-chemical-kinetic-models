! DECOMPOSITION OF SUBSEQUENT PROD/RADICALS

C2H4 + BT1EN3Q4J = HX1EN3Q6J 1.32E+4 2.48 6130. ! C2H4 + C2H5 = PC4H9, TABLE 3 FROM H.J. CURRAN 

