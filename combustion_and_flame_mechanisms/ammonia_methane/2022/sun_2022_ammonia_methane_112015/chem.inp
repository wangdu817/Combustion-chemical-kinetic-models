!   ! IC4H7+O2 1st and 2nd O2 addition reactions  YWH
!   ! C.-J. Chen, J.W. Bozzelli, The Journal of Physical Chemistry A 104 (2000) 9715-9732.
!   IC4H7+O2 = IC4H7O2                                            2.04E+69	 -18.34	   19667 
!   !Analogy with NC3H7O2+HO2<=>NC3H7O2H+O2                                    
!   IC4H7O2+HO2 = IC4H7OOH+O2                                     1.75E+10    0.00     -3.275E+03
!   !Analogy with NC3H7O2+CH2O<=>NC3H7O2H+HCO                                    
!   IC4H7O2+CH2O = IC4H7OOH+HCO                                   5.60E+12    0.00      1.36E+04   
!   !Analogy with 2CH3OCH2O2 = O2+CH3OCH2OH+CH3OCHO                       
!   IC4H7O2+IC4H7O2 = O2+IC4H7OH+IC3H5CHO                        5.42E10     0.00      -1390
!   
!   ! X.L. Zheng, H.Y. Sun, C.K. Law, The Journal of Physical Chemistry A 109 (2005) 9044-9053.
!   IC4H7O2 = IC4H6OOH-I                                          4.87E+03    2.13     18760    
!   IC4H7O2 = IC3H5CHO+OH										  8.01E+05    1.86     34770
!   IC4H7O2 = C2CYCOOC-I1										  2.45E+06    1.47     26360
!   IC4H7O2 = CCYCCOOC-T1                                         9.28E+07    0.88     25170
!   C2CYCOOC-I1 = CCYC2OCO                                        2.39E+11    0.34     13790
!   CCYC2OCO = CCYCCO-T1+CH2O                                     1.63E+12    0.57     14830
!   !
!   IC4H6OOH-I<=>CVCYCCOC+OH                                       6.90E+11	 0.00E+00	3.32E+04                  ! A factor: Miyoshi, J. Phys. Chem. A 2011, 115, 3301–3325; Ea:  Zheng, et al.,J. Phys. Chem. A 2005, 109, 9044-9053
!   IC4H6OOH-I<=>C3H4-A+CH2O2H                                   +1.1800000E+012 +9.1203000E-001 +5.1390000E+004  !
!   IC4H6OOH-I<=>IC3H5CHO+OH                                     +2.4200000E+009 +8.7390000E-001 +5.4090000E+004  !
!   
!   !----------------------------YWH
!   !ADD new reaction pathways leading to the formation of IC4H6KET
!   ! Analogy to the 1st O2 addition reaction
!   IC4H6OOH-I+O2 = IC4H6OOH-IO2                                  2.04E+69	 -18.34	   19667
!   ! C.-J. Chen, J.W. Bozzelli, The Journal of Physical Chemistry A 104 (2000) 9715-9732.
!   IC4H6OOH-IO2 = IC4H6KET+OH                                    6.61E+05    1.37     18190  
!   ! Analogy to IC4KETII=>CH2O+C2H5CO+OH 
!   IC4H6KET => OH+CH2O+C3H3O                                     1.50E+16    0.00     42000   !1.50E+16
!   !
!   !Analogy to IC4H7+HO2
!   IC4H6OOH-I+HO2 = IC4H6(OOH)                                   1.03E+045  -10.6  7.8515E+003  !1.03E+045
