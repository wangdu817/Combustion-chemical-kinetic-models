!! ***************************** Sub mechanism for low temperature ignition (LLNL) ******************************************************   
!
!!-----------------------> addition of o2 to alkyl radicals <-------------------------------
!  C10H21O2-1 = PXC10H21+O2                2.657E+20   -1.67   3.540E+04
!  C10H21O2-2 = SXC10H21+O2                1.357E+23   -2.36   3.767E+04 
!  C10H21O2-3 = S2XC10H21+O2               1.357E+23   -2.36   3.767E+04
!  C10H21O2-4 = S3XC10H21+O2               1.357E+23   -2.36   3.767E+04
!  C10H21O2-5 = S4XC10H21+O2               1.357E+23   -2.36   3.767E+04
! 
!!----------------------> ro2 isomerization <-----------------------------------------------
!
!  C10H21O2-1 = C10OOH1-3                  2.500E+10    0.00   2.085E+04
!  C10H21O2-2 = C10OOH2-4                  2.500E+10    0.00   2.085E+04
!  C10H21O2-3 = C10OOH3-5                  2.500E+10    0.00   2.085E+04
