DECALIN+CH3O2=DCL-3R+CH3O2H     4.08E+01 3.58 14180.0
!
! c2h3 rates, uf=3                                                                                            
!
DECALIN+C2H3=DCL-1R+C2H4     4.0E+11  0. 14300.
DECALIN+C2H3=DCL-2R+C2H4     1.6E+12  0. 16800.
DECALIN+C2H3=DCL-3R+C2H4     1.6E+12  0. 16800.
