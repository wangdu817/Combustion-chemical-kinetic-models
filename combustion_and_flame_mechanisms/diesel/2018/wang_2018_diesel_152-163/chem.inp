!mchr2+o2=mche+ho2     9.0E+11   0.0   7530.  !CVN: abstraction rate based on Evans/Polani
!
MCHR2+O2=MCH2OO    1.75E+14 -0.7 -506.0  ! Fernandes et al. Zador, PCCP 2009 for chxrad+o2=chxo2j, 50 bar rate 
