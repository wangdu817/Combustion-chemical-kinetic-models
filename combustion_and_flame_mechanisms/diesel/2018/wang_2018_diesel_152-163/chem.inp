!BC8H17O2+C6H5CH3=C6H5CH2+BC8H17O2H    1.02E+04 2.5 12339.3 
!CC8H17O2+C6H5CH3=C6H5CH2+CC8H17O2H    1.02E+04 2.5 12339.3 
