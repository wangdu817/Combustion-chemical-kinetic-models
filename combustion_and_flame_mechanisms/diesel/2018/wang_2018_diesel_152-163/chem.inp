!------------------ c5h81-3 abstraction reactions -----------------------
O+C5H81-3=OH+CVCCVCCJ  5.24E+11 0.7 5884 !prf mech for abstraction from C*CC
! Duplicate reaction to Metcalfe-Mehl toluene mech   
! oh+c*cc*cc=h2o+c*cc*ccj  3.12E+06 2 -298 !prf mech for abstraction from C*CC
O2+C5H81-3=HO2+CVCCVCCJ  4.00E+12 0 39900 !prf mech for abstraction from C*CC
C2H5+C5H81-3=C2H6+CVCCVCCJ  1.00E+11 0 9800 !prf mech for abstraction from C*CC
HO2+C5H81-3=H2O2+CVCCVCCJ  1.50E+11 0 14190 !prf mech for abstraction from C*CC
