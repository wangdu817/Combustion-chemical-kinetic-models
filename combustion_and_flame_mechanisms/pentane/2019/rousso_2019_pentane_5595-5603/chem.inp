O(1D) + C3H8 => C3H7(I) + OH                 !  2.2d-10
O(1D) + C3H8 => C3H7(N) + OH                 !  2.2d-10
O(1D) + C4H9H => C4H9(P) + OH                !  2.2d-10
O(1D) + C4H9H => C4H9(S) + OH                !  2.2d-10
