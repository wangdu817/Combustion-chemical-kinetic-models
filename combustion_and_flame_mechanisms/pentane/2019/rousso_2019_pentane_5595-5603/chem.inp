# D.S. Stafford, et al, J. Appl. Phys. 96 (5) (2004) 2451-2465.
O + O + HE => O2(A1) + HE               !  9.88d-35
O + O2 + HE => O3 + HE                  !  3.40d-34*(Tgas/300.0d0)**-1.2

# M. Capitelli, et al, Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York.
O2  + @M => O + O + @M                  !  6.1d-9*(1.0d0-exp(-2240.0d0/Tgas))*exp(-59380.0d0/Tgas)*@R
    @M = O2     O    
    @R = 5.9d0  21.d0 
O3  + @M => O2 + O + @M                 !  6.6d-10*exp(-11600.0d0/Tgas)*@R
    @M = O2      O
    @R = 0.38d0  6.3d0*exp(170.0d0/Tgas)
O + O + @M => O2 + @M                   !  4.0d-33*(300.0d0/Tgas)**0.41*@R
    @M = O2     O      
    @R = 1.0d0  3.6d0  
O + O2 + @M => O3 + @M                  !  7.6d-34*(300.0d0/Tgas)**1.9
    @M = O2 
O + O2 + @M => O3 + @M                  !  min(3.9d-33*(300.0d0/Tgas)**1.9,1.1d-34*exp(1060.0d0/Tgas))
    @M = O	

END








                             
