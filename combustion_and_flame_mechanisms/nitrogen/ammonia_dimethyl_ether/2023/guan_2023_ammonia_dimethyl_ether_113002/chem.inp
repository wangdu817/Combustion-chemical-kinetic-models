! Klaus 1997 error (+/-0.150) also used by Tian 2009/Zhang 2011/Glarborg 2018
HCO+NO=HNO+CO    7.2E12 0.0 0.0E0
! RAS/GLA2008 (15%)
HCO+NO2=>NO+CO+OH    5.0E12 0.0 0.0E0
! RAS/GLA2008 (70%)
HCO+NO2=>NO+CO2+H    2.3E13 0.0 0.0E0
! RAS/GLA2008 (15%)
HCO+NO2=HONO+CO    5.0E12 0.0 0.0E0
! Tian 2009 | Xu ZF Lin MC IJCK 36:205 2004
HCO+HNO=CH2O+NO    5.8E-1 3.8 1.15E2
! Klaus 1997 also used by Lamoureux 2016
CO2+N=NO+CO    1.9E11 0.0 3.4E3
!-------------------------CH2O REACTIONS---------------------------------------!
! RASMUSSEN 2008 | Xu ZF Lin MC IJCK 35:184 2003
CH2O+NO2=HONO+HCO    1.42E-7 5.64 9.22E3
! Coppens 2007
CH4+NH=CH3+NH2    9.0E13 0.0 2.008E4
CH4+NH2=CH3+NH3    1.5E3 3.0 9.94E3
! Glarborg 2018 cited J. Chai, CF Goldsmith Proc Combust Inst 36 2017 617-626
! Added in this work
CH4+NO2=CH3+HONO    1.1E-1 4.28 2.63E4
    DUP
CH4+NO2=CH3+HONO    7.4E1 3.42 3.31E4
    DUP
! 4.000E+13 / Alzueta 1999 also used by RASMUSSEN 2008/Tian 2009/Mathieu 2016 : GLA/BEN99
CH3+NO2=CH3O+NO    4.0E13 -0.2 0.0E0
! Glarborg 2018 cited YM Choi, MC Lin Int J Chem Kinet 2005 37 261-274 ! Added in this work
CH3+HNO=CH4+NO    1.5E11 0.76 3.48E2
! Daguat 2005 : C_F 140 (2005) 161   171 cited Alzueta 1999
CH3O+NO=CH2O+HNO    1.3E14 -0.7 0.0E0
! Daguat 2005; C_Flame 140 (2005) 161   171 also used by Alzueta 1999/Mendiara 2009
CH3O+NO2=HONO+CH2O    6.0E12 0.0 2.285E3
! RAS 2008/Coppens 2007 also used by /Konnov 2009/Dayma 2007
CH3O+HNO=CH3OH+NO    3.16E13 0.0 0.0E0
! Alzueta 1999, A/2.500E+12
CH3O2+NO=CH3O+NO2    4.0E12 0.0 -3.58E2
! Dagaut 1999; Combust. Sci. and Tech.1999,Vol 148, pp 27-57 !##
CH3O+HONO=CH3OH+NO2    8.1E5 1.9 5.504E3
