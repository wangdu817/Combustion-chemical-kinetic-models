                                                          ! ch3cho + h from Whytock et al J.Chem.Phys 65 (1976)
hex5enal + H = HX1N6*O3J + H2      5.02e+04 2.5 -1912.    ! Rate rule for secondary Allylic H, Heyberger et al
                                                          ! IJCK 34:666-677 (2002)
hex5enal + CH3 = HX1N6*O5J + CH4   1.34e+13 0.0  3300.    ! H abs by ch3 of h on c=o
                                                          ! Assume rate rule for aldehydic H from nc7_38 LLNL mech
hex5enal + CH3 = HX1N6*O3J + CH4   1.00e-01 3.50 4046.    ! Used primary rate rule for Allylic H, Heyberger et al
                                                          ! IJCK 34:666-677 (2002)
