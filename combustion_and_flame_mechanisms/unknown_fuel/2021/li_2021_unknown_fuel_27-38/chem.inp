2HO2=H2O2+O2    1.179E9 0.7712 -1.825E3
    DUP
2HO2=H2O2+O2    1.251E12 0.295 7.397E3
    DUP
! Troe, Combust. Flame,  158:594-601 (2011)
! Rate constant is for Ar
H2O2(+M)=2OH(+M)    2.0E12 0.9 4.8749E4
    H2O/7.5/
    CO2/1.6/
    N2/1.5/
    O2/1.2/
    HE/0.65/
    H2O2/7.7/
    H2/3.7/
    CO/2.8/
    LOW/2.49E24 -2.3E0 4.8749E4/
    TROE/4.3E-1 1.0E-30 1.0E30/
! Tsang and Hampson, J. Phys. Chem. Ref. Data, 15:1087 (1986)
H2O2+H=H2O+OH    2.41E13 0.0 3.97E3
H2O2+H=HO2+H2    4.82E13 0.0 7.95E3
H2O2+O=OH+HO2    9.55E6 2.0 3.97E3
! Hong et al., J. Phys. Chem. A  114 (2010) 5718?727
H2O2+OH=HO2+H2O    1.74E12 0.0 3.18E2
    DUP
H2O2+OH=HO2+H2O    7.59E13 0.0 7.27E3
    DUP
!
!======================
!CO-HCO Reactions
!======================
! Troe, 15th Symposium
CO+O(+M)=CO2(+M)    1.8E10 0.0 2.384E3
    H2/2.5/
    H2O/12.0/
    CO/1.9/
    CO2/3.8/
    AR/0.87/
    LOW/1.55E24 -2.79E0 4.191E3/
! Tsang and Hampson, JPC Ref. Data, 15:1087 (1986)
CO+O2=CO2+O    2.53E12 0.0 4.77E4
! (This study) least squares fit to available experimental results
!CO+OH = CO2+H                               2.229E+05  1.89 -1.1587E+03
! Joshi and Wang, International Journal of Chemical Kinetics (2006) Vol. 38, pp. 57-73
! The rate used is the low pressure limit value.
CO+OH=CO2+H    7.046E4 2.053 -2.762E2
    DUP
CO+OH=CO2+H    5.757E12 -0.664 3.319E2
    DUP
!REF:you et al. j. phys. chem. a 2007, 111, 4031-4042
CO+HO2=CO2+OH    1.57E5 2.18 1.794E4
! Yang et al., 8th U. S. National Combustion Meeting, 2013, 070RK-0163.
HCO(+M)=H+CO(+M)    4.93E16 -0.93 1.9724E4
    N2/1.5/
    HE/1.5/
    O2/1.5/
    CO/1.5/
    H2/2.0/
    CH4/5.0/
    CO2/3.0/
    H2O/15.0/
    LOW/7.43E21 -2.36E0 1.9383E4/
    TROE/1.03E-1 1.39E2 1.09E4 4.55E3/
! FassheberN Friedrichs G Marshall P Glarborg P J. Phys. Chem. A 119 (2015) 7305-7315.
HCO+O2=CO+HO2    6.9E6 1.9 -1.369E3
! Tsang W Hampson RF JPCRD 15:1087 1986
HCO+HO2=CO2+OH+H    3.0E13 0.0 0.0E0
! Glarborg et al's paper (C_F, 132:629, 2003)
2HCO=CH2O+CO    3.0E13 0.0 0.0E0
! Friedrichs G Herbon JT Davidson DF Hanson RK CPPC 4:5778-5788 2002
HCO+H=CO+H2    1.1E14 0.0 0.0E0
! Baulch DL Cobos CJ Cox RA Esser C Frank P Just Th Kerr JA Pilling MJ Troe J Walker RW Warnatz J JPCRD 21:403 1992
HCO+O=CO+OH    3.0E13 0.0 0.0E0
! Baulch DL Cobos CJ Cox RA Esser C Frank P Just Th Kerr JA Pilling MJ Troe J Walker RW Warnatz J JPCRD 21:403 1992
HCO+O=CO2+H    3.0E13 0.0 0.0E0
