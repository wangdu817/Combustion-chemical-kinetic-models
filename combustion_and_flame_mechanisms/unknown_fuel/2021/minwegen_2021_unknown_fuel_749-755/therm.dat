!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
! CYC3H2O(+M)<=>C2H2+CO(+M)
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!***************************************************
!               GLOBAL SECTION
!***************************************************
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
!
TemperatureList[K]                      300 500 700 900 1000 1200 1400 1600 1800 2000 2200 2400
PressureList[atm]                       0.0001 0.001 0.01 0.1 1.0 2.0 5.0 10.0 20.0 50.0 100.0 1000.0
!
!
EnergyStepOverTemperature               .2         ! [Discretization energy step (global relax matrix)] / T
ExcessEnergyOverTemperature             100         ! [Highest barrier in the model (global relax matrix)] / T
ModelEnergyLimit[kcal/mol]              1000        ! Highest reference energy used in the calculation ( or ReferenceEnergy[kcal/mol])
!
CalculationMethod                       direct     ! direct or low-eigenvalue
ReductionMethod                         projection ! threshold (default), sort_out (most accurate but costly), incremental, sequential
WellProjectionThreshold                 0.2        ! default=0.2
!
WellCutoff                              10         ! well truncation parameter : Max { dissociation limit (min barrier rel. to bottom of the well) / T }
ChemicalEigenvalueMax                   0.2        ! Max chemical eigenvalue / Lowest Collision relaxation eigenvalue
!
!** Reference energy **
Reactant                                r01        ! Species whose ground energy will be used as a reference for energy
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!***************************************************
!               MODEL SECTION
!***************************************************
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
!
Model
!
  EnergyRelaxation                                                      ! Default collisional energy relaxation kernel
    Exponential                                                         ! Currently the only possible energy relaxation model
       Factor[1/cm]                     228                             ! Savchenkova -> Jasper et al. (Delta_E_down)^(0) @ standard T (300 K)
       Power                            0.86                            ! Savchenkova -> Jasper et al. Power n in the expression (Delta_E_down) = (Delta_E_down)^(0) (T/T0)^(n)
       ExponentCutoff                   10                              ! if (Delta_E) / (Delta_E_down) > value  transition probability is zero
    End
!
  CollisionFrequency                                                    ! Collision frequency model
    LennardJones                                                        ! Currently the only possible collisional frequency model
       Epsilons[K]                      942.10     97.84                 ! Epsilon_1 cyclopropenone Computation and Epsilon_2 N2 Jasper database
       Sigmas[angstrom]                   5.47      3.61                 ! Sigma_1   cyclopropenone Computation and Sigma_2   N2 Jasper database
       Masses[amu]                       54.05    28.00                 ! Masses of the buffer gas molecule and of the complex (check order)
    End
!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!***************************************************
!  WELLs
!***************************************************
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!***************************************************
