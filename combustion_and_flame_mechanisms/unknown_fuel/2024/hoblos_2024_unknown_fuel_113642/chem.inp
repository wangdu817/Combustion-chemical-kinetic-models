jo2cy(ccoccc)=ho2cy(ccjoccc)                6.150e+08  1.050 25600 !DBE_Thion: c4oc4h8oo-b<=>c4oc4-bo2h-a (1-4s -3kcal) 

jo2cy(ccoccc)=ho2cy(ccocccj)                6.150e+08  1.050 28600 !DBE_Thion: c4oc4h8oo-b<=>c4oc4-bo2h-c (1-4s)

jo2cy(cccocc)=ho2cy(ccjcocc)                8.640e+08  1.260 28600 !DBE_Thion: c4oc4h8oo-c<=>c4oc4-co2h-b (1-4s)  !*2 (4H/2H)
!
!*** h-atom shift from gamma position ro2=qooh ***!
!
jo2cy(cocccc)=ho2cy(cocjccc)                6.180e+08  0.930 15400 !DBE_Thion: c4oc4h8oo-a<=>c4oc4-ao2h-1 (1-5s -3kcal)     

jo2cy(cocccc)=ho2cy(cocccjc)                6.180e+08  0.930 18400 !DBE_Thion: c4oc4h8oo-a<=>c4oc4-ao2h-c (1-5s)

jo2cy(ccoccc)=ho2cy(ccoccjc)                5.340e+05  1.120 15700 !DBE_Thion: c4oc4h8oo-b<=>c4oc4-bo2h-2 (1-7s)

jo2cy(cccocc)=ho2cy(cccjocc)                1.236e+09  0.930 15400 !DBE_Thion: c4oc4h8oo-c<=>c4oc4-co2h-a (1-5s -3kcal)  !*2 (4H/2H)
!
!*** h-atom shift from delta position ro2=qooh ***!
! 
