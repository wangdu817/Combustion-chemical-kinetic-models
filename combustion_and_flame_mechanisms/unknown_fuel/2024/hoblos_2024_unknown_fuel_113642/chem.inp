ho2cy(coccjcc)=cy(o)25THP+oh                2.420e+07  1.010 10300 !DBE_Thion: c4oc4-ao2h-2<=>c4oc4oa-2+oh (s./s-ooh)

ho2cy(ccjoccc)=bicy(o)(cocccc)+oh           4.780e+09  0.790  9600 !DBE_Thion: c4oc4-bo2h-a<=>c4oc4oa-b+oh (s./s-ooh)

ho2cy(ccocccj)=bicy(o)(ccoccc)+oh           4.780e+09  0.790  9600 !DBE_Thion: c4oc4-bo2h-c<=>c4oc4ob-c+oh (s./s-ooh)

ho2cy(ccoccjc)=cy(o)35THP+oh                2.680e+09  0.620 15900 !DBE_Thion: c4oc4-co2h-a<=>c4oc4oa-c+oh (s./s-ooh)

ho2cy(ccocjcc)=cy(o)25THP+oh                2.420e+07  1.010 10300 !DBE_Thion: c4oc4-bo2h-1<=>c4oc4oa-2+oh (s./s-ooh) 

ho2cy(ccjcocc)=bicy(o)(ccoccc)+oh           4.780e+09  0.790  9600 !DBE_Thion: c4oc4-co2h-b<=>c4oc4ob-c+oh (s./s-ooh)

ho2cy(cccjocc)=cy(o)24THP+oh                2.680e+09  0.620 15900 !DBE_Thion: c4oc4-co2h-a<=>c4oc4oa-c+oh (s./s-ooh)	
!
!*** beta-scission (radical in gamma position from -cooh)***!  
!
ho2cy(cocjccc)=>ohcccccho+oh                3.150e+43 -9.450  39900 !DBE_Thion: c4oc4-ao2h-1=>nc3h7cho+nc3h7cho+oh 

