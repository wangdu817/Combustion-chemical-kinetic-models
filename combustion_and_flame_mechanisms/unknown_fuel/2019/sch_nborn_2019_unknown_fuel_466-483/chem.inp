!**********************************************************************!
!*             Primary mechanism of the oxidation of furan            *!
!**********************************************************************!
!**********************************************************************!

!****************************************************!
!* Reactions of furan                               *!
!****************************************************!

!**unimolecular initiation
!*rupture of C-C and C-H
furan=CH2CCHCHO                 4.58E12    0.416  70891.0  !high pressure A*2
furan=C2H2T+CH2COZ              1.82E14    0.534  86591.0  !high pressure
R1H+furyl-2=furan               1.00E14    0.000      0.0  !Est. by analogy with c-C5H10 TSA78!
R1H+furyl-3=furan               1.00E14    0.000      0.0  !Est. by analogy with c-C5H10 TSA78!

!**bimolecular initiation
furan+O2=furyl-2+R3OOH          2.00E13    0.000  70680.0   !A-I-3 secondary A*2!
furan+O2=furyl-3+R3OOH          2.00E13    0.000  70880.0   !A-I-3 secondary A*2!

!**reaction with H atoms
furan+R1H=C4H5O-2               2.60E13    0.000   3200.0   !as C4H6Z2+R1H=C4H7-1
furan+R1H=C4H5O-3               2.60E13    0.000   1560.0   !as C4H6Z2+R1H=C4H7Y

!**reaction with OH atoms
furan+R2OH=C2H3CHOZ+R5CHO       2.74E12    0.000  -1040.0   !Table A-I-5

!**H-abstraction

furan+R1H=furyl-2+H2            8.20E5     2.500   12280.0  !A-I-20 secondary A*2
furan+R1H=furyl-3+H2            8.20E5     2.500   12280.0  !A-I-20 secondary A*2
furan+B1O=furyl-2+R2OH          1.20E11    0.700    8960.0  !A-I-20 secondary A*2
furan+B1O=furyl-3+R2OH          1.20E11    0.700    8960.0  !A-I-20 secondary A*2
furan+R2OH=furyl-2+H2O          2.20E6     2.000    2780.0  !A-I-20 secondary A*2
furan+R2OH=furyl-3+H2O          2.20E6     2.000    2780.0  !A-I-20 secondary A*2
furan+R4CH3=furyl-2+CH4         1.36       3.500   12900.0  !A-I-20 secondary A*2
furan+R4CH3=furyl-3+CH4         1.36       3.500   12900.0  !A-I-20 secondary A*2


!*******************************************************!
!* Reactions of furyl radicals                         *!
!*******************************************************!

!isomerization
furyl-3=furyl-2                  1.50E13   0.000   67800.0  !as  iC4H5=nC4H5 <LEUnG95>!

!reaction with O2
furyl-2+O2=RCH2CHCO+CO2           4.50E16  -1.390    1000.0  !O2+R10C2H3V=HCHO+R5CHO  !(266a,-266a)<MEBEL nIST>!
furyl-2+O2=>CHCHCHO+B2CO+B1O     3.30E11  -0.290      10.0  !O2+R10C2H3V=B1O+R13CH2CHO(266b,-266b)<MEBEL nIST>!
furyl-3+O2=RCH2CHCO+CO2           4.50E16  -1.390    1000.0  !O2+R10C2H3V=HCHO+R5CHO  !(266a,-266a)<MEBEL nIST>!
furyl-3+O2=>C2H2T+R5CHO+B2CO+B1O 3.30E11  -0.290      10.0  !O2+R10C2H3V=B1O+R13CH2CHO(266b,-266b)<MEBEL nIST>!

!reaction with O
furyl-2+B1O=CHCHCHO+B2CO         3.00E13   0.000       0.0  !B1O+R10C2H3V=CH2COZ+R1H  !RAS/GLA08b
furyl-3+B1O=C2H2T+R5CHO+B2CO     3.00E13   0.000       0.0  !B1O+R10C2H3V=CH2COZ+R1H  !RAS/GLA08b

!B1O+R10C2H3V=R4CH3+B2CO         3.00E13   0.000       0.0  !(66,-66)<DAGAUT91>!

!**bete-scission decomposition
furyl-2=CHCHCHCO                 1.81E13   0.341   34511.0  !CBSQ-B3 high pressure!
furyl-3=CHCCHCHO                 1.05E13   0.306   31215.0  !CBSQ-B3 high pressure!


