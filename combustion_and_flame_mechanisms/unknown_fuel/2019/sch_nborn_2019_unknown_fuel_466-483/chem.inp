CH2CHCH2CHO+R2OH=B2CO+RC3H5Y+H2O   4.2E12    0.000    500.0  !as CH3CHO+R2OH=R14CH3CO+H2O but a global reaction

!*******************************************************!
!* Reactions of C5H8O      CH2//CH/CH(CH3)CHO          *!
!*******************************************************!
C5H8O+R1H=B2CO+C4H7Y+H2        4.00E13   0.000      4200.0  !as CH3CHO+R1H=H2+R14CH3CO but a global reaction
C5H8O+R4CH3=B2CO+C4H7Y+CH4     2.00E-6   5.600      2500.0  !as CH3CHO+R4CH3=R14CH3CO+CH4 but a global reaction
C5H8O+R2OH=B2CO+C4H7Y+H2O      4.20E12   0.000       500.0  !as CH3CHO+R2OH=R14CH3CO+H2O but a global reaction

!*******************************************************!
!* Reactions of C5H6O      CHCCH(CH3)CHO               *!
!*******************************************************!
C5H6O+R1H=B2CO+C4H5-1s+H2      4.00E13   0.000      4200.0  !as CH3CHO+R1H=H2+R14CH3CO but a global reaction
C5H6O+R4CH3=B2CO+C4H5-1s+CH4   2.00E-6   5.600      2500.0  !as CH3CHO+R4CH3=R14CH3CO+CH4 but a global reaction
C5H6O+R2OH=B2CO+C4H5-1s+H2O    4.20E12   0.000       500.0  !as CH3CHO+R2OH=R14CH3CO+H2O but a global reaction

