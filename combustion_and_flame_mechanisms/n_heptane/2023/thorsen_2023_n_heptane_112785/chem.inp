!
! Reaction class: R + NO2 = RO + NO
!                 
! Molecules: n-alkanes 
!
! The rate constants are taken the same as for C2H5 + NO2 in the mechanism of
! Glarborg et al. (Prog. Energy Combust. Sci. 67 (2018) 31-68)
!

C6H13-1+NO2=NO+C6H13O-1        4.0E13 -0.200 0
C6H13-2+NO2=NO+C6H13O-2        4.0E13 -0.200 0
C6H13-3+NO2=NO+C6H13O-3        4.0E13 -0.200 0
C5H11-1+NO2=NO+C5H11O-1        4.0E13 -0.200 0
C5H11-2+NO2=NO+C5H11O-2        4.0E13 -0.200 0
C5H11-3+NO2=NO+C5H11O-3        4.0E13 -0.200 0
NC3H7+NO2=NO+NC3H7O                                    4.0E13 -0.200 0
IC3H7+NO2=NO+IC3H7O                                    4.0E13 -0.200 0 
PC4H9+NO2=NO+PC4H9O                                    4.0E13 -0.200 0
SC4H9+NO2=NO+SC4H9O                                    4.0E13 -0.200 0

!
! Reaction class: RH + NO2 = R + HONO
!
! the rate constants per H atom are from Chan et al., Phys. Chem. Chem. Phys. 3 (2001), 56-62
!
!ABSTRACTION OF PRIMARY H: 	 	             2.2E+13      0.0     31100 !
!ABSTRACTION OF SECONDARY H:  	             5.8E+12      0.0     28100 !
!ABSTRACTION OF TERTIARY H:   	             9.3E+12      0.0     25800 !
!
C4H10+NO2=PC4H9+HONO                                   1.32E+14    0.000   31100 ! 6P
C4H10+NO2=SC4H9+HONO                                   2.32E+13    0.000   28100 ! 4S
IC4H10+NO2=IC4H9+HONO                                  1.98E+14    0.000   31100 ! 9P
IC4H10+NO2=TC4H9+HONO                                  9.30E+12    0.000   25800 ! 1T
NC5H12+NO2=C5H11-1+HONO                                1.32E+14    0.000   31100 ! 6P
NC5H12+NO2=C5H11-2+HONO                                2.32E+13    0.000   28100 ! 4S
NC5H12+NO2=C5H11-3+HONO                                1.16E+13    0.000   28100 ! 2S
NC7H16+NO2=C7H15-1+HONO                                1.32E+14    0.000   31100 ! 6P
NC7H16+NO2=C7H15-2+HONO                                2.32E+13    0.000   28100 ! 4S
NC7H16+NO2=C7H15-3+HONO                                2.32E+13    0.000   28100 ! 4S
NC7H16+NO2=C7H15-4+HONO                                1.16E+13    0.000   28100 ! 2S
!
NC6H14+NO2=C6H13-1+HONO    1.32E+14    0.000   31100             ! 6P        
NC6H14+NO2=C6H13-2+HONO    2.32E+13    0.000   28100             ! 4S        
NC6H14+NO2=C6H13-3+HONO    2.32E+13    0.000   28100             ! 4S     
!
C3H8+NO2=NC3H7+HONO        1.32E+14    0.000   31100             ! 6P
C3H8+NO2=IC3H7+HONO        1.16E+13    0.000   28100             ! 2S
!
! Reaction class: R + HNO = RH + NO
!
! same rate constant as CH3 + HNO,
! rate constant is from 
! YM Choi, MC Lin Int J Chem Kinet 2005 37 261-274
!
C2H5+HNO=NO+C2H6                                       1.5E11   0.760     348 
NC3H7+HNO=NO+C3H8                                      1.5E11   0.760     348 !
IC3H7+HNO=NO+C3H8                                      1.5E11   0.760     348 !
PC4H9+HNO=NO+C4H10                                     1.5E11   0.760     348 !
SC4H9+HNO=NO+C4H10                                     1.5E11   0.760     348 !
!
C5H11-1+HNO=NO+NC5H12                                  1.5E11   0.760     348 !                         
C5H11-2+HNO=NO+NC5H12                                  1.5E11   0.760     348 !
C5H11-3+HNO=NO+NC5H12                                  1.5E11   0.760     348 !
!
C6H13-1+HNO=NO+NC6H14                                  1.5E11   0.760     348
C6H13-2+HNO=NO+NC6H14                                  1.5E11   0.760     348
C6H13-3+HNO=NO+NC6H14                                  1.5E11   0.760     348
!
C7H15-1+HNO=NO+NC7H16                                  1.5E11   0.760     348 
C7H15-2+HNO=NO+NC7H16                                  1.5E11   0.760     348 
C7H15-3+HNO=NO+NC7H16                                  1.5E11   0.760     348 
C7H15-4+HNO=NO+NC7H16                                  1.5E11   0.760     348 
!
!
!
! Reaction class: RO2 + NO = RO + NO2
!
! same rate constant as CH3O2+NO=CH3O+NO2                     
! rate constant is from
!ATKINSON R BAULCH DL COX RA CROWLEY JN HAMPSON RF HYNES RG JENKIN ME ROSSI MJ TROE JACP 6:3625-4055 2006
!

C5H11O2-1+NO=C5H11O-1+NO2                              1.40E+12    0.000    -715  
C5H11O2-2+NO=C5H11O-2+NO2                              1.40E+12    0.000    -715   
C5H11O2-3+NO=C5H11O-3+NO2                              1.40E+12    0.000    -715 
!
C2H5O2+NO=C2H5O+NO2                                    1.40E+12    0.000    -715 
IC3H7O2+NO=IC3H7O+NO2                                  1.40E+12    0.000    -715 
NC3H7O2+NO=NC3H7O+NO2                                  1.40E+12    0.000    -715 
PC4H9O2+NO=PC4H9O+NO2                                  1.40E+12    0.000    -715 
SC4H9O2+NO=SC4H9O+NO2                                  1.40E+12    0.000    -715 
!
C6H13O2-1+NO=C6H13O-1+NO2                              1.40E+12    0.000    -715
C6H13O2-2+NO=C6H13O-2+NO2                              1.40E+12    0.000    -715
C6H13O2-3+NO=C6H13O-3+NO2                              1.40E+12    0.000    -715
!
C7H15-1O2+NO=C7H15-1O+NO2                              1.40E+12    0.000    -715 
C7H15-2O2+NO=C7H15-2O+NO2                              1.40E+12    0.000    -715 
C7H15-3O2+NO=C7H15-3O+NO2                              1.40E+12    0.000    -715 
C7H15-4O2+NO=C7H15-4O+NO2                              1.40E+12    0.000    -715 
!
