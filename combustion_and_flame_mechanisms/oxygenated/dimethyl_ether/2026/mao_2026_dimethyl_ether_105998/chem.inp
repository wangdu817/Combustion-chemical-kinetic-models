# Plasma kinetics
# This case corresponds to a DME/N2 and DME/O2/N2 plasma consisting of electrons, electronically excited species, ions, and neutrals.
# Mech authors: Xingqian Mao, et al.
# Tianjin University



ELEMENTS
C H O N AR HE E
END

SPECIES
# Combustion species
H            H2            CH2           CH2(S)        CH3
O            CH4           OH            H2O           C2H
C2H2         C2H3          CO            N2            C2H4
HCO          C2H5          CH2O          C2H6          CH2OH
CH3O         O2            CH3OH         HO2           H2O2
HCCO         CH2CO         HCCOH         CH2CHO        CH3CO
CO2          CH3CHO        OCHO          CH3CHOH       C2H4OH
CH3CH2O      CH3OCH2       HOCHO         CH3OCH3       C2H5OH
HOCH2O       CH3OCO        CH3OCHO       CH3OCH2O      CH3OCH2OH
OCH2OCHO     HOCH2OCO      HOC2H4O2      CH3OCH2O2     CH2OCH2O2H
CH3OCH2O2H   HO2CH2OCHO    O2CH2OCH2O2H  AR            HE
C CH HCOH C2O CH3O2 CH3O2H C3H2 C3H2(SING) C3H2(c) C3H3 C3H6 
C3H6(c) C4H2 C3H4(p) C3H4(a)
C3H4(c) C3H5(a) C3H5(s) C3H5(t) C4H3(n) C4H3(i) C4H4 C4H5(n) C4H5(i) C4H6(13)
H2CC CH2CHOH C4H5C2H C6H6(F) C6H6 C6H5 C2H3CHO C2H3CO
O3 CH2OCHO  HOCO 
C2H5O 
HOCH2O2 HOCH2O2H O2CHO HO2CHO C3H7(n) C3H7(i) C3H8 C2 OCHCHO

# NH3 subset
NH3 NH2 NH N NNH N2H4 N2H3 HNNH(t) HNNH(c) H2NN
NH2OH H2NO HNOH HNO HON NO NO2 HONO HNO2 NO3 HONO2 N2O

# Other N-species
HCN HNC CN HNCO HOCN 
HCNO NCO NCN HNCN NCNO HCCN
NCNOH HNCNH NCCN CH3NO CH2NO 
C2H5NO CH3CHNO CH2CHNO CHCHNO CH3NO2 
CH2NO2 C2H5NO2 CH2CH2NO2 CH3CHNO2 CH3ONO 
CH3ONO2 CH3CH2ONO CH3CH2ONO2 CH3NH2 CH2NH2 CH3ONH2 CH3OCH2NH2 CH2OCH2NH2
CH3OCHNH2 CH3OCH2NH
CH3NH CH2NH H2CN HCNH CH3CH2NH2 
CH2CH2NH2 CH3CHNH2 CH3CH2NH CH2CHNH2 CH3CHNH 
CH2CHNH CH2CNH2 CH3CNH CH3CHN CHCHNH2 
CH3CN CHCNH2 CH2CNH CH2CHN CH2CHN(S) 
C2H3N(c) CH2CN CHCNH H2NCHO H2NCO 
CH3NHCH3 CH3NHCH2 CH3NCH3 CH3NCH2 CH2NCH2 CH3NCH
HNNO(t) HNNO(c) NHNO H2NNO2 HNNOOH(t) HNNOOH(c)

# Plasma species
# Excited species
O2(v1)  O2(v2)  O2(v3)  O2(v4)
N2(v1)  N2(v2)  N2(v3)  N2(v4)  N2(v5)  N2(v6)  N2(v7)  N2(v8)
O2(A1)  O2(B1)  O2*  	O(1D)  	O(1S)
N2(A)   N2(B)   N2(a')  N2(C)   N(2D)   

# Ions 
CH3OCH3^+   
O2^+    O4^+
N2^+    N4^+
H2O^+   H3O^+
O^-     O2^-    O4^-    OH^-   
E
END

BOLSIG
CH3OCH3 O2 N2 H2O
END


REACTIONS
$ double precision :: kVT10_O2DME, kVT10_O2N2, kVT10_O2O2, kVT10_O2CO2, kVT10_O2H2O ! cm3.s-1
$ double precision :: kVT10_O2H2, kVT10_O2CH4, kVT10_O2C2H2, kVT10_O2C2H4, kVT10_O2C2H6 ! cm3.s-1
$ double precision :: kVT10_O2C3H8, kVT10_O2OH, kVT10_O2H, kVT10_O2O, kVT10_O2NH3 ! cm3.s-1
$ double precision :: kVT10_N2DME, kVT10_N2N2, kVT10_N2O2, kVT10_N2CO2, kVT10_N2H2O ! cm3.s-1 
$ double precision :: kVT10_N2H2, kVT10_N2CH4, kVT10_N2C2H2, kVT10_N2C2H4, kVT10_N2C2H6 ! cm3.s-1 
$ double precision :: kVT10_N2C3H8, kVT10_N2OH, kVT10_N2H, kVT10_N2O, kVT10_N2N, kVT10_N2NH3 ! cm3.s-1
$ double precision :: kVV10_O2O2, kVV10_N2N2 ! cm3.s-1
$ double precision :: M ! cm-3
$ double precision :: k0 ! cm6.s-1
$ double precision :: ktot, kR1, kR2, kR3 ! cm3.s-1

# Rate constant is in dependence on pressure and temperature.
# Note that M will change with pressure.
# Rate constant is calculated at 60 Torr.
$ M = 60.d0/760.d0*101325.0d0/1.38064852d-17/Tgas
$ ktot = 3.0d-11*Tgas**0.17*exp(-2726.0d0/Tgas)
$ k0 = 2.2d-37*Tgas**2.34*exp(-1350.0d0/Tgas)
$ kR1 = 6.8d-16*Tgas**1.51*exp(-3040.0d0/Tgas)
$ kR2 = ktot*(k0*M/(ktot+k0*M))
$ kR3 = ktot-kR1-kR2

# VT-O2/N2 Rate constant Definition
$ kVT10_O2DME = 1.05d-15*Tgas
$ kVT10_O2N2 = exp(-28.02d0-132.0d0/Tgas**(1.0d0/3.0d0))
$ kVT10_O2O2 = exp(-18.32d0-157.0d0/Tgas**(1.0d0/3.0d0)) 
$ kVT10_O2CO2 = Tgas*exp(-27.34d0-146.5d0/Tgas**(1.0d0/3.0d0)) 
$ kVT10_O2H2O = 100*exp(-18.32d0-157.0d0/Tgas**(1.0d0/3.0d0)) 
$ kVT10_O2H2 = exp(-22.04d0-91.5d0/Tgas**(1.0d0/3.0d0))
$ kVT10_O2CH4 = Tgas*exp(-30.39d0-41.45d0/Tgas**(1.0d0/3.0d0))
$ kVT10_O2C2H2 = Tgas*exp(-33.61d0-17.27d0/Tgas**(1.0d0/3.0d0))
$ kVT10_O2C2H4 = 1.05d-15*Tgas
$ kVT10_O2C2H6 = 1.05d-15*Tgas
$ kVT10_O2C3H8 = 1.05d-15*Tgas
$ kVT10_O2OH = 100*exp(-18.32d0-157.0d0/Tgas**(1.0d0/3.0d0)) 
$ kVT10_O2H = 1.7*exp(-22.04d0-91.5d0/Tgas**(1.0d0/3.0d0))
$ kVT10_O2O = Tgas*exp(-28.87d0-111.0d0/Tgas**(1.0d0/3.0d0)) 
$ kVT10_O2NH3 = 100*exp(-18.32d0-157.0d0/Tgas**(1.0d0/3.0d0))

$ kVT10_N2DME = 6.0d-16*Tgas
$ kVT10_N2N2 = Tgas*exp(-22.86d0-328.9d0/Tgas**(1.0d0/3.0d0)+993.3d0/Tgas**(2.0d0/3.0d0))
$ kVT10_N2O2 = Tgas*exp(-22.86d0-328.9d0/Tgas**(1.0d0/3.0d0)+993.3d0/Tgas**(2.0d0/3.0d0))
$ kVT10_N2CO2 = exp(-19.414d0-134.73d0/Tgas**(1.0d0/3.0d0)+253.2d0/Tgas**(2.0d0/3.0d0)+251.7d0/Tgas) 
$ kVT10_N2H2O = Tgas*exp(-35.12d0-21.18d0/Tgas**(1.0d0/3.0d0))
$ kVT10_N2H2 = Tgas*exp(-24.89d0-167.24d0/Tgas**(1.0d0/3.0d0)+394.43d0/Tgas**(2.0d0/3.0d0))
$ kVT10_N2CH4 = 3.2d-14*Tgas*exp(-41.45d0/Tgas**(1.0d0/3.0d0))
$ kVT10_N2C2H2 = 1.2d-15*Tgas*exp(-17.27d0/Tgas**(1.0d0/3.0d0))
$ kVT10_N2C2H4 = 6.0d-16*Tgas
$ kVT10_N2C2H6 = 6.0d-16*Tgas
$ kVT10_N2C3H8 = 6.0d-16*Tgas
$ kVT10_N2OH = Tgas*exp(-24.89d0-167.24d0/Tgas**(1.0d0/3.0d0)+394.43d0/Tgas**(2.0d0/3.0d0))
$ kVT10_N2H = 3.1d0*Tgas*exp(-24.89d0-167.24d0/Tgas**(1.0d0/3.0d0)+394.43d0/Tgas**(2.0d0/3.0d0))
$ kVT10_N2O = Tgas*exp(-34.03d0-33.11d0/Tgas**(1.0d0/3.0d0))
$ kVT10_N2N = 4.0d-16*(Tgas/300.0d0)**0.5
$ kVT10_N2NH3 = Tgas*exp(-35.12d0-21.18d0/Tgas**(1.0d0/3.0d0))

# VV-O2/N2 Rate constant Definition
$ kVV10_O2O2 = 0.9d-14*(Tgas/300.0d0)**1.5
$ kVV10_N2N2 = 0.9d-14*(Tgas/300.0d0)**1.5

#-----------------------------------------------------------------------
#
# Electron impact reactions
#
#-----------------------------------------------------------------------

# Rotational excitation
# Biagi database, www.lxcat.net.
E + O2 => E + O2                       ! BOLSIG O2 -> O2(rot)
# Phelps database, www.lxcat.net. 
E + N2 => E + N2                       ! BOLSIG N2 -> N2(rot)

# Vibrational excitation
# I.N. Kosarev, et al., Combustion and Flame 203 (2019) 72-82.
# It is assumed that CH3OCH3(v) is quickly consumed by VT relaxation. 
# (according to CH4 results,X. Mao and Q. Chen, AIAA JOURNAL, 56 (11) (2018) 4312-4320).
E + CH3OCH3 => E + CH3OCH3  		   ! BOLSIG CH3OCH3 -> CH3OCH3(v1)
E + CH3OCH3 => E + CH3OCH3  		   ! BOLSIG CH3OCH3 -> CH3OCH3(v2)
E + CH3OCH3 => E + CH3OCH3  		   ! BOLSIG CH3OCH3 -> CH3OCH3(v3)
E + CH3OCH3 => E + CH3OCH3  		   ! BOLSIG CH3OCH3 -> CH3OCH3(v4)
E + CH3OCH3 => E + CH3OCH3 			   ! BOLSIG CH3OCH3 -> CH3OCH3(v5)
# Biagi database, www.lxcat.net.
E + O2 => E + O2(v1)                   ! BOLSIG O2 -> O2(v1)     
E + O2 => E + O2(v2)                   ! BOLSIG O2 -> O2(v2)
E + O2 => E + O2(v3)                   ! BOLSIG O2 -> O2(v3)
E + O2 => E + O2(v4)                   ! BOLSIG O2 -> O2(v4)
# Phelps database, www.lxcat.net.
E + N2 => E + N2(v1)                   ! BOLSIG N2 -> N2(v1res)
E + N2 => E + N2(v1)                   ! BOLSIG N2 -> N2(v1)
E + N2 => E + N2(v2)                   ! BOLSIG N2 -> N2(v2)
E + N2 => E + N2(v3)                   ! BOLSIG N2 -> N2(v3)
E + N2 => E + N2(v4)                   ! BOLSIG N2 -> N2(v4)
E + N2 => E + N2(v5)                   ! BOLSIG N2 -> N2(v5)
E + N2 => E + N2(v6)                   ! BOLSIG N2 -> N2(v6)
E + N2 => E + N2(v7)                   ! BOLSIG N2 -> N2(v7)
E + N2 => E + N2(v8)                   ! BOLSIG N2 -> N2(v8)

# Electronic excitation
# Biagi database, www.lxcat.net.
E + O2 => E + @B                       ! BOLSIG O2 -> @R
    @B = O2(A1)  O2(B1)  O2*
    @R = O2(A1)  O2(B1)  O2*
# Phelps database, www.lxcat.net.
E + N2 => E + N2(A)                    ! BOLSIG N2 -> @R
   @R = N2(A3,v0-4)  N2(A3,v5-9)  N2(A3,v10-)
E + N2 => E + N2(B)                    ! BOLSIG N2 -> @R
   @R = N2(B3)   N2(W3)   N2(B'3)
E + N2 => E + N2(a')                   ! BOLSIG N2 -> @R
   @R = N2(a'1)  N2(a1)   N2(w1)
E + N2 => E + N2(C)                    ! BOLSIG N2 -> @R
   @R = N2(C3)   N2(E3)   N2(a''1)
   
# Dissociation
# I.N. Kosarev, et al., Combustion and Flame 203 (2019) 72-82.
E + CH3OCH3 => E + CH3O + CH3          ! BOLSIG CH3OCH3 -> CH3O + CH3
E + CH3OCH3 => E + CH3OCH2 + H         ! BOLSIG CH3OCH3 -> CH3OCH2 + H    
# Biagi database, www.lxcat.net.
E + O2 => E + O + O                    ! BOLSIG O2 -> O + O
E + O2 => E + O + O(1D)                ! BOLSIG O2 -> O + O(1D)
E + O2 => E + O + O(1S)                ! BOLSIG O2 -> O + O(1S)
# P.C. Cosby, J. Chem. Phys. 98 (1993) 9544.
E + N2 => E + N + N(2D)                ! BOLSIG N2 -> N2(SUM)
# Morgan database, www.lxcat.net.
E + H2O => E + H + OH                  ! BOLSIG H2O -> H + OH
E + H2O => E + O + H2                  ! BOLSIG H2O -> O + H2

# Ionization
# I.N. Kosarev, et al., Combustion and Flame 203 (2019) 72-82.
E + CH3OCH3 => E + E + CH3OCH3^+       ! BOLSIG CH3OCH3 -> CH3OCH3+
# Biagi database, www.lxcat.net.
E + O2 => E + E + O2^+                 ! BOLSIG O2 -> O2^+
# Phelps database, www.lxcat.net.
E + N2 => E + E + N2^+                 ! BOLSIG N2 -> N2^+
# Morgan database, www.lxcat.net.
E + H2O => E + E + H2O^+               ! BOLSIG H2O -> H2O^+

# Attachment 
# Biagi database, www.lxcat.net.
E + O2 => O^- + O                      ! BOLSIG O2 -> O^- + O
# Morgan database, www.lxcat.net.
E + H2O => H2 + O^-                    ! BOLSIG H2O -> H2 + O^-
E + H2O => OH^- + H                    ! BOLSIG H2O -> OH^- + H
# A. Starikovskiy and N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
E + O + O => O^- + O                   ! 8.33d-31
E + O2 + H2 => O2^- + H2               ! 4.8d-31
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
E + O + O2 => O^- + O2                 ! 1.0d-31
E + O + O2 => O2^- + O                 ! 1.0d-31
E + O2 + N2 => O2^- + N2               ! 1.07d-31*(300.0d0/Te)**2*exp(-70.0d0/Tgas)*exp(1500.0d0*(Te-Tgas)/(Te*Tgas))
E + O2 + O2 => O2^- + O2               ! 1.40d-29*(300.0d0/Te)*exp(-600.0d0/Tgas)*exp(700.0d0*(Te-Tgas)/(Te*Tgas))
E + O2 + H2O => O2^- + H2O             ! 1.40d-29
# J. Prager, et al., Proc. Combust. Inst. 31 (2007) 1129-1137.
E + OH + ANY_NEUTRAL => OH^- + ANY_NEUTRAL     ! 3.01d-31
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
E + O => O^-                           ! 1.0d-15
E + OH => OH^-                         ! 1.0d-15

#-----------------------------------------------------------------------
#
# Electron-ion recombination reactions
#
#-----------------------------------------------------------------------

# KIDA Kinetic Database for Astrochemistry.
E + CH3OCH3^+ => O + CH3 + CH3        ! 0.5d-7*(300.0d0/Te)**0.5
E + CH3OCH3^+ => CH2O + CH4           ! 5.0d-7*(300.0d0/Te)**0.5  
E + CH3OCH3^+ => CH2 + CH3OH          ! 0.5d-7*(300.0d0/Te)**0.5
#E + CH3OCH3^+ => CH2O + CH4           ! 3.0d-7*(300.0d0/Te)**0.5  
#E + CH3OCH3^+ => CH2 + CH3OH          ! 1.5d-7*(300.0d0/Te)**0.5      

# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
E + O2^+ => O  + @B                   ! 2.7d-7*(300.0d0/Te)**0.7*@R
    @B = O       O(1D)   O(1S)
    @R = 0.55d0  0.40d0  0.05d0
E + O4^+ => O2 + O2                   ! 1.4d-6*(300.0d0/Te)**0.5
E + N2^+ => N  + @B                   ! 1.8d-7*(300.0d0/Te)**0.39*@R
    @B = N       N(2D)
    @R = 0.50d0  0.50d0
E + N4^+ => N2 + N2                   ! 2.3d-6*(300.0d0/Te)**0.53

# I.A. Kossyi, et al., Plasma Sources Sci. Technol. 1 (1992) 207-220.
E + O2^+ + E => O2 + E                ! 1.0d-19*(300.0d0/Te)**4.5
E + O2^+ + O2 => O2 + O2              ! 6.0d-27*(300.0d0/Te)**1.5

# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
E + O4^+ + E => O2 + O2 + E           ! 7.18d-27/(Te/11605.0d0)**4.5

# UMIST RATE12, astrochemistry.net.
E + H2O^+ => O + H2                   ! 3.9d-8*(300.0d0/Te)**0.5
E + H2O^+ => O + H + H                ! 3.05d-7*(300.0d0/Te)**0.5
E + H2O^+ => OH + H                   ! 8.6d-8*(300.0d0/Te)**0.5
E + H3O^+ => H2O + H                  ! 7.09d-8*(300.0d0/Te)**0.5
E + H3O^+ => O + H2 + H               ! 5.6d-9*(300.0d0/Te)**0.5
E + H3O^+ => OH + H2                  ! 5.37d-8*(300.0d0/Te)**0.5
E + H3O^+ => OH + H + H               ! 3.05d-7*(300.0d0/Te)**0.5

#-----------------------------------------------------------------------
#
# Vibrational-Translational (VT) relaxation of O2(v)
#
#-----------------------------------------------------------------------

# SSH theory and approximations for the Morse oscillator model.
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
# A. Starikovskiy and N. Aleksandrov, Prog. Energy Combust. Sci. 39 (1) (2013) 61-110.
# A. Starikovskiy and N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017
# The VT relaxation rate constant of O2(v1) with DME is assumed as the same as O2(v1) with C2H6.
O2(v1) + CH3OCH3 => O2 + CH3OCH3         ! kVT10_O2DME
O2(v2) + CH3OCH3 => O2(v1) + CH3OCH3     ! kVT10_O2DME*2.015*exp(1.45d0*(18.872d0/Tgas)**0.5) 
O2(v3) + CH3OCH3 => O2(v2) + CH3OCH3     ! kVT10_O2DME*3.047*exp(2.90d0*(18.872d0/Tgas)**0.5) 
O2(v4) + CH3OCH3 => O2(v3) + CH3OCH3     ! kVT10_O2DME*4.094*exp(4.35d0*(18.872d0/Tgas)**0.5)

O2(v1) + N2 => O2 + N2                   ! kVT10_O2N2 
O2(v2) + N2 => O2(v1) + N2               ! kVT10_O2N2*2.015*exp(1.45d0*(14.933d0/Tgas)**0.5) 
O2(v3) + N2 => O2(v2) + N2               ! kVT10_O2N2*3.047*exp(2.90d0*(14.933d0/Tgas)**0.5)  
O2(v4) + N2 => O2(v3) + N2               ! kVT10_O2N2*4.094*exp(4.35d0*(14.933d0/Tgas)**0.5) 

O2(v1) + O2 => O2 + O2                   ! kVT10_O2O2 
O2(v2) + O2 => O2(v1) + O2               ! kVT10_O2O2*2.015*exp(1.45d0*(16.0d0/Tgas)**0.5) 
O2(v3) + O2 => O2(v2) + O2               ! kVT10_O2O2*3.047*exp(2.90d0*(16.0d0/Tgas)**0.5)  
O2(v4) + O2 => O2(v3) + O2               ! kVT10_O2O2*4.094*exp(4.35d0*(16.0d0/Tgas)**0.5)  

O2(v1) + CO2 => O2 + CO2                 ! kVT10_O2CO2
O2(v2) + CO2 => O2(v1) + CO2             ! kVT10_O2CO2*2.015*exp(1.45d0*(18.526d0/Tgas)**0.5) 
O2(v3) + CO2 => O2(v2) + CO2             ! kVT10_O2CO2*3.047*exp(2.90d0*(18.526d0/Tgas)**0.5) 
O2(v4) + CO2 => O2(v3) + CO2             ! kVT10_O2CO2*4.094*exp(4.35d0*(18.526d0/Tgas)**0.5) 

O2(v1) + H2O => O2 + H2O                 ! kVT10_O2H2O 
O2(v2) + H2O => O2(v1) + H2O             ! kVT10_O2H2O*2.015*exp(1.45d0*(11.52d0/Tgas)**0.5) 
O2(v3) + H2O => O2(v2) + H2O             ! kVT10_O2H2O*3.047*exp(2.90d0*(11.52d0/Tgas)**0.5)  
O2(v4) + H2O => O2(v3) + H2O             ! kVT10_O2H2O*4.094*exp(4.35d0*(11.52d0/Tgas)**0.5) 

O2(v1) + H2 => O2 + H2                   ! kVT10_O2H2
O2(v2) + H2 => O2(v1) + H2               ! kVT10_O2H2*2.015*exp(1.45d0*(1.882d0/Tgas)**0.5) 
O2(v3) + H2 => O2(v2) + H2               ! kVT10_O2H2*3.047*exp(2.90d0*(1.882d0/Tgas)**0.5)
O2(v4) + H2 => O2(v3) + H2               ! kVT10_O2H2*4.094*exp(4.35d0*(1.882d0/Tgas)**0.5)

O2(v1) + CH4 => O2 + CH4                 ! kVT10_O2CH4
O2(v2) + CH4 => O2(v1) + CH4             ! kVT10_O2CH4*2.015*exp(1.45d0*(10.667d0/Tgas)**0.5) 
O2(v3) + CH4 => O2(v2) + CH4             ! kVT10_O2CH4*3.047*exp(2.90d0*(10.667d0/Tgas)**0.5) 
O2(v4) + CH4 => O2(v3) + CH4             ! kVT10_O2CH4*4.094*exp(4.35d0*(10.667d0/Tgas)**0.5) 

O2(v1) + C2H2 => O2 + C2H2               ! kVT10_O2C2H2
O2(v2) + C2H2 => O2(v1) + C2H2           ! kVT10_O2C2H2*2.015*exp(1.45d0*(14.344d0/Tgas)**0.5) 
O2(v3) + C2H2 => O2(v2) + C2H2           ! kVT10_O2C2H2*3.047*exp(2.90d0*(14.344d0/Tgas)**0.5) 
