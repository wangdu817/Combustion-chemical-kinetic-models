N2(v7) + O => N2(v6) + O                  !  kVT10_N2O*7.266*exp(11.483d0/Tgas**(1.0d0/3.0d0))
N2(v8) + O => N2(v7) + O                  !  kVT10_N2O*8.357*exp(13.396d0/Tgas**(1.0d0/3.0d0))

N2(v1) + N => N2 + N                      !  kVT10_N2N
N2(v2) + N => N2(v1) + N                  !  kVT10_N2N*2.012*exp(1.859d0/Tgas**(1.0d0/3.0d0))
N2(v3) + N => N2(v2) + N                  !  kVT10_N2N*3.037*exp(3.718d0/Tgas**(1.0d0/3.0d0))
N2(v4) + N => N2(v3) + N                  !  kVT10_N2N*4.075*exp(5.577d0/Tgas**(1.0d0/3.0d0))
N2(v5) + N => N2(v4) + N                  !  kVT10_N2N*5.125*exp(7.436d0/Tgas**(1.0d0/3.0d0))
N2(v6) + N => N2(v5) + N                  !  kVT10_N2N*6.189*exp(9.295d0/Tgas**(1.0d0/3.0d0))
N2(v7) + N => N2(v6) + N                  !  kVT10_N2N*7.266*exp(11.154d0/Tgas**(1.0d0/3.0d0))
N2(v8) + N => N2(v7) + N                  !  kVT10_N2N*8.357*exp(13.013d0/Tgas**(1.0d0/3.0d0))

N2(v1) + NH3 => N2 + NH3                  !  kVT10_N2NH3
N2(v2) + NH3 => N2(v1) + NH3              !  kVT10_N2NH3*2.012*exp(1.938d0/Tgas**(1.0d0/3.0d0))
N2(v3) + NH3 => N2(v2) + NH3              !  kVT10_N2NH3*3.037*exp(3.877d0/Tgas**(1.0d0/3.0d0))
N2(v4) + NH3 => N2(v3) + NH3              !  kVT10_N2NH3*4.075*exp(5.815d0/Tgas**(1.0d0/3.0d0))
N2(v5) + NH3 => N2(v4) + NH3              !  kVT10_N2NH3*5.125*exp(7.753d0/Tgas**(1.0d0/3.0d0))
N2(v6) + NH3 => N2(v5) + NH3              !  kVT10_N2NH3*6.189*exp(9.691d0/Tgas**(1.0d0/3.0d0))
N2(v7) + NH3 => N2(v6) + NH3              !  kVT10_N2NH3*7.266*exp(11.630d0/Tgas**(1.0d0/3.0d0))
N2(v8) + NH3 => N2(v7) + NH3              !  kVT10_N2NH3*8.357*exp(13.568d0/Tgas**(1.0d0/3.0d0))

#-----------------------------------------------------------------------
#
# Vibrational-Vibrational (VV) interactions of O2(v)
#
#-----------------------------------------------------------------------

# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O2(v1) + O2(v1) => O2 + O2(v2)           ! kVV10_O2O2*2.015*exp(6.378d0/Tgas**0.5)
O2(v1) + O2(v2) => O2 + O2(v3)           ! kVV10_O2O2*3.047*exp(12.756d0/Tgas**0.5)
O2(v1) + O2(v3) => O2 + O2(v4)           ! kVV10_O2O2*4.094*exp(19.134d0/Tgas**0.5)

O2(v2) + O2 => O2(v1) + O2(v1)           ! kVV10_O2O2*2.015*exp(6.378d0/Tgas**0.5)
O2(v2) + O2(v2) => O2(v1) + O2(v3)       ! kVV10_O2O2*6.14*exp(6.378d0/Tgas**0.5)
O2(v2) + O2(v3) => O2(v1) + O2(v4)       ! kVV10_O2O2*8.251*exp(12.756d0/Tgas**0.5)

O2(v3) + O2 => O2(v2) + O2(v1)           ! kVV10_O2O2*3.047*exp(12.756d0/Tgas**0.5)
O2(v3) + O2(v1) => O2(v2) + O2(v2)       ! kVV10_O2O2*6.14*exp(6.378d0/Tgas**0.5)
O2(v3) + O2(v3) => O2(v2) + O2(v4)       ! kVV10_O2O2*12.472*exp(6.378d0/Tgas**0.5)
 
O2(v4) + O2 => O2(v3) + O2(v1)           ! kVV10_O2O2*4.094*exp(19.134d0/Tgas**0.5)
O2(v4) + O2(v1) => O2(v3) + O2(v2)       ! kVV10_O2O2*8.251*exp(12.756d0/Tgas**0.5)
O2(v4) + O2(v2) => O2(v3) + O2(v3)       ! kVV10_O2O2*12.472*exp(6.378d0/Tgas**0.5)

