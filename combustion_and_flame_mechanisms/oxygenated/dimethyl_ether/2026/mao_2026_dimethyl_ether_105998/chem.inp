N2(v2) + N2(v2) => N2(v1) + N2(v3)       ! kVV10_N2N2*6.112*exp(6.611d0/Tgas**0.5)*0.88
N2(v2) + N2(v3) => N2(v1) + N2(v4)       ! kVV10_N2N2*8.199*exp(13.223d0/Tgas**0.5)*0.84
N2(v2) + N2(v4) => N2(v1) + N2(v5)       ! kVV10_N2N2*10.314*exp(19.834d0/Tgas**0.5)*0.8
N2(v2) + N2(v5) => N2(v1) + N2(v6)       ! kVV10_N2N2*12.454*exp(26.445d0/Tgas**0.5)*0.76
N2(v2) + N2(v6) => N2(v1) + N2(v7)       ! kVV10_N2N2*14.622*exp(33.057d0/Tgas**0.5)*0.72
N2(v2) + N2(v7) => N2(v1) + N2(v8)       ! kVV10_N2N2*16.818*exp(39.668d0/Tgas**0.5)*0.68

N2(v3) + N2 => N2(v2) + N2(v1)           ! kVV10_N2N2*3.037*exp(13.223d0/Tgas**0.5)*0.88
N2(v3) + N2(v1) => N2(v2) + N2(v2)       ! kVV10_N2N2*6.112*exp(6.611d0/Tgas**0.5)*0.88
N2(v3) + N2(v3) => N2(v2) + N2(v4)       ! kVV10_N2N2*12.375*exp(6.611d0/Tgas**0.5)*0.84
N2(v3) + N2(v4) => N2(v2) + N2(v5)       ! kVV10_N2N2*15.566*exp(13.223d0/Tgas**0.5)*0.8
N2(v3) + N2(v5) => N2(v2) + N2(v6)       ! kVV10_N2N2*18.797*exp(19.834d0/Tgas**0.5)*0.76
N2(v3) + N2(v6) => N2(v2) + N2(v7)       ! kVV10_N2N2*22.069*exp(26.445d0/Tgas**0.5)*0.72
N2(v3) + N2(v7) => N2(v2) + N2(v8)       ! kVV10_N2N2*25.383*exp(33.057d0/Tgas**0.5)*0.68

N2(v4) + N2 => N2(v3) + N2(v1)           ! kVV10_N2N2*4.075*exp(19.834d0/Tgas**0.5)*0.84
N2(v4) + N2(v1) => N2(v3) + N2(v2)       ! kVV10_N2N2*8.199*exp(13.223d0/Tgas**0.5)*0.84
N2(v4) + N2(v2) => N2(v3) + N2(v3)       ! kVV10_N2N2*12.375*exp(6.611d0/Tgas**0.5)*0.84
N2(v4) + N2(v4) => N2(v3) + N2(v5)       ! kVV10_N2N2*20.884*exp(6.611d0/Tgas**0.5)*0.8
N2(v4) + N2(v5) => N2(v3) + N2(v6)       ! kVV10_N2N2*25.219*exp(13.223d0/Tgas**0.5)*0.76
N2(v4) + N2(v6) => N2(v3) + N2(v7)       ! kVV10_N2N2*29.608*exp(19.834d0/Tgas**0.5)*0.72
N2(v4) + N2(v7) => N2(v3) + N2(v8)       ! kVV10_N2N2*34.054*exp(26.445d0/Tgas**0.5)*0.68

N2(v5) + N2 => N2(v4) + N2(v1)           ! kVV10_N2N2*5.125*exp(26.445d0/Tgas**0.5)*0.8
N2(v5) + N2(v1) => N2(v4) + N2(v2)       ! kVV10_N2N2*10.314*exp(19.834d0/Tgas**0.5)*0.8
N2(v5) + N2(v2) => N2(v4) + N2(v3)       ! kVV10_N2N2*15.566*exp(13.223d0/Tgas**0.5)*0.8
N2(v5) + N2(v3) => N2(v4) + N2(v4)       ! kVV10_N2N2*20.884*exp(6.611d0/Tgas**0.5)*0.8
N2(v5) + N2(v5) => N2(v4) + N2(v6)       ! kVV10_N2N2*31.721*exp(6.611d0/Tgas**0.5)*0.76
N2(v5) + N2(v6) => N2(v4) + N2(v7)       ! kVV10_N2N2*37.242*exp(13.223d0/Tgas**0.5)*0.72
N2(v5) + N2(v7) => N2(v4) + N2(v8)       ! kVV10_N2N2*42.834*exp(19.834d0/Tgas**0.5)*0.68

N2(v6) + N2 => N2(v5) + N2(v1)           ! kVV10_N2N2*6.189*exp(33.057d0/Tgas**0.5)*0.76
N2(v6) + N2(v1) => N2(v5) + N2(v2)       ! kVV10_N2N2*12.454*exp(26.445d0/Tgas**0.5)*0.76
N2(v6) + N2(v2) => N2(v5) + N2(v3)       ! kVV10_N2N2*18.797*exp(19.834d0/Tgas**0.5)*0.76
N2(v6) + N2(v3) => N2(v5) + N2(v4)       ! kVV10_N2N2*25.219*exp(13.223d0/Tgas**0.5)*0.76
N2(v6) + N2(v4) => N2(v5) + N2(v5)       ! kVV10_N2N2*31.721*exp(6.611d0/Tgas**0.5)*0.76
N2(v6) + N2(v6) => N2(v5) + N2(v7)       ! kVV10_N2N2*44.972*exp(6.611d0/Tgas**0.5)*0.72
N2(v6) + N2(v7) => N2(v5) + N2(v8)       ! kVV10_N2N2*51.725*exp(13.223d0/Tgas**0.5)*0.68

N2(v7) + N2 => N2(v6) + N2(v1)           ! kVV10_N2N2*7.266*exp(39.668d0/Tgas**0.5)*0.72
N2(v7) + N2(v1) => N2(v6) + N2(v2)       ! kVV10_N2N2*14.622*exp(33.057d0/Tgas**0.5)*0.72
N2(v7) + N2(v2) => N2(v6) + N2(v3)       ! kVV10_N2N2*22.069*exp(26.445d0/Tgas**0.5)*0.72
N2(v7) + N2(v3) => N2(v6) + N2(v4)       ! kVV10_N2N2*29.608*exp(19.834d0/Tgas**0.5)*0.72
N2(v7) + N2(v4) => N2(v6) + N2(v5)       ! kVV10_N2N2*37.242*exp(13.223d0/Tgas**0.5)*0.72
N2(v7) + N2(v5) => N2(v6) + N2(v6)       ! kVV10_N2N2*44.972*exp(6.611d0/Tgas**0.5)*0.72
N2(v7) + N2(v7) => N2(v6) + N2(v8)       ! kVV10_N2N2*60.729*exp(6.611d0/Tgas**0.5)*0.68

N2(v8) + N2 => N2(v7) + N2(v1)           ! kVV10_N2N2*8.357*exp(46.279d0/Tgas**0.5)*0.68
N2(v8) + N2(v1) => N2(v7) + N2(v2)       ! kVV10_N2N2*16.818*exp(39.668d0/Tgas**0.5)*0.68
N2(v8) + N2(v2) => N2(v7) + N2(v3)       ! kVV10_N2N2*25.383*exp(33.057d0/Tgas**0.5)*0.68
N2(v8) + N2(v3) => N2(v7) + N2(v4)       ! kVV10_N2N2*34.054*exp(26.445d0/Tgas**0.5)*0.68
N2(v8) + N2(v4) => N2(v7) + N2(v5)       ! kVV10_N2N2*42.834*exp(19.834d0/Tgas**0.5)*0.68
N2(v8) + N2(v5) => N2(v7) + N2(v6)       ! kVV10_N2N2*51.725*exp(13.223d0/Tgas**0.5)*0.68
N2(v8) + N2(v6) => N2(v7) + N2(v7)       ! kVV10_N2N2*60.729*exp(6.611d0/Tgas**0.5)*0.68

#-----------------------------------------------------------------------
#
# Optical transitions and predissociation
#
#-----------------------------------------------------------------------

# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O2(A1) => O2                       ! 2.6d-4
O2(B1) => O2(A1)                   ! 1.5d-3
O2(B1) => O2                       ! 8.5d-2
O2* => O2                          ! 11.0d0
N2(A) => N2                        ! 0.50d0
N2(B) => N2(A)                     ! 1.34d5
N2(a') => N2                       ! 1.0d2
N2(C) => N2(B)                     ! 2.45d7

# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O(1D) => O                         ! 5.0d-3
O(1S) => O(1D)                     ! 1.34d0

#-----------------------------------------------------------------------
#
# Quenching of excited states of O2
#
#-----------------------------------------------------------------------

# Reactions of O2(A1)
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O2(A1) + O => O2 + O                          ! 7.0d-16
O2(A1) + N => NO + O                          ! 2.0d-14*exp(-600.0d0/Tgas)
O2(A1) + O2 => O2 + O2                        ! 3.8d-18*exp(-205.0d0/Tgas)
O2(A1) + N2 => O2 + N2                        ! 3.0d-21
O2(A1) + NO => O2 + NO                        ! 2.5d-11
O2(A1) + O3 => O2 + O2 + O(1D)                ! 5.2d-11*exp(-2840.0d0/Tgas)
O2(A1) + O2(A1) => O2 + O2(B1)                ! 7.0d-28*Tgas**3.8*exp(700.0d0/Tgas) 
# R. Atkinson, et al., Atmos. Chem. Phys. Discuss. 3 (2003) 6179-6699.
O2(A1) + H2O => O2 + H2O                      ! 5.0d-18
O2(A1) + CO2 => O2 + CO2                      ! 2.0d-20
# N.A. Popov, Plasma Sources Sci. Technol. 20 (2011) 045002.
O2(A1) + H2 => OH + OH                        ! 2.8d-9*exp(-17906.0d0/Tgas)
O2(A1) + H2 => O2 + H2                        ! 4.5d-18*(Tgas/300.0d0)**0.5
# A. A. Chukalovsky, et al., J. Phys. D: Appl. Phys. 49 (2016) 485202.
# The third-body coefficients of H + O2(a1)(+M) => HO2(+M) are assumed as the same as O2.
O2(A1) + H => OH + O                          ! kR1
O2(A1) + H => HO2                             ! kR2
O2(A1) + H => O2 + H                          ! KR3
# A. Starik and A. Sharipov, Phys. Chem. Chem. Phys. 13 (2011) 16424-16436.
O2(A1) + H2 => H + HO2                        ! 1.84d-16*Tgas**1.88*exp(-17070.0d0/Tgas)
O2(A1) + H2O => OH + HO2                      ! 3.40d-9*exp(-24990.0d0/Tgas)
# L.B. Ibraguimova, et al., Institute of Mechanics of Lomonosov, Moscow State University, 2003.
O2(A1) + H2 => H2O + O(1D)                    ! 5.81d-11*exp(-20000.0d0/Tgas)
O2(A1) + OH => H + O3                         ! 7.31d-17*Tgas**1.44d0*exp(-27225.0d0/Tgas)
O2(A1) + OH => O + HO2                        ! 2.16d-11*exp(-17000.0d0/Tgas)
O2(A1) + OH => O2 + OH                        ! 5.65d-18
O2(A1) + H2O2 => O2 + H2O2                    ! 5.65d-18
O2(A1) + HO2 => O2 + HO2                      ! 5.65d-18
# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O2(A1) + O2 => O3 + O                         ! 2.95d-21*(Tgas/300.0d0)**0.5
O2(A1) + O2(A1) => O2 + O2                    ! 9.0d-17*exp(-560.0d0/Tgas)
O + O2(A1) + O2 => O + O2 + O2                ! 1.0d-32
# A. Starikovskiy and N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
O2(A1) + H2 => O2(B1) + H2                    ! 8.3d-13*exp(-7660.0d0/Tgas)
O2(A1) + H2O => O + H2O2                      ! 2.05d-12*Tgas**0.5*exp(-35100.d0/Tgas)
# F. Zhang, et al., Proc. Combust. Inst. 38 (2020).
# 1 atm, 300-2000 K.
O2(A1) + CH3 => O2 + CH3                      ! 3.95d-12*Tgas**0.11d0*exp(-4695.0d0/Tgas)
O2(A1) + CH3 => CH2O + OH                     ! 9.98d-14*Tgas**0.47d0*exp(-4780.6d0/Tgas)
O2(A1) + CH3 => CH3O + O                      ! 1.94d-22*Tgas**3.25d0*exp(-4956.7d0/Tgas)
# N. Tsolas, R.A. Yetter, I.V. Adamovich, Combust. Flame 176 (2017) 462-478.
O2(A1) + CH2O => HO2 + HCO                    ! 1.66d-10*exp(-11600.0d0/Tgas)
# J.K. Lefkowitz, et al, Proc. Combust. Inst. 35 (3) (2015) 3505-3512. 
O2(A1) + CO => CO2 + O                        ! 5.25d-13*exp(-14446.0d0/Tgas)
# R.B. Boodaghians, et al., Chem. Phys. Lett. 97 (1983) 193-197.
O2(A1) + NH3 => O2 + NH3                      ! 8.92d-18 

# Reactions of O2(B1)
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O2(B1) + O => O2(A1) + O                      ! 8.1d-14
O2(B1) + O => O2 + O(1D)                      ! 3.4d-11*(300.0d0/Tgas)**0.1*exp(-4200.0d0/Tgas)
O2(B1) + O2 => O2(A1) + O2                    ! 4.3d-22*Tgas**2.4*exp(-281.0d0/Tgas)
O2(B1) + O3 => O2 + O2 + O                    ! 2.2d-11
O2(B1) + N2 => O2(A1) + N2                    ! 1.7d-15*(Tgas/300.0d0)
O2(B1) + NO => O2(A1) + NO                    ! 6.0d-14
# W.V. Gaens and A. Bogaerts, J. Phys. D: Appl. Phys. 46 (2013) 275201.
O2(B1) + O => O2 + O                          ! 8.0d-15*(Tgas/300.0d0)**0.5d0
O2(B1) + H => O2(A1) + H                      ! 7.2d-14*(Tgas/300.0d0)**0.5d0
O2(B1) + H => O2 + H                          ! 8.0d-15*(Tgas/300.0d0)**0.5d0
O2(B1) + O2(B1) => O2(A1) + O2                ! 3.6d-17*(Tgas/300.0d0)**0.5d0
O2(B1) + H2 => O2 + H2                        ! 4.9d-15*exp(-253.0d0/Tgas)
O2(B1) + H2O => O2 + H2O                      ! 2.3d-12
O2(B1) + O3 => O2(A1) + O2 + O                ! 1.0d-14
O2(B1) + O3 => O2 + O3                        ! 2.2d-11
O2(B1) + O3 => O2(A1) + O3                    ! 2.2d-11
# A. Starik and A. Sharipov, Phys. Chem. Chem. Phys. 13 (2011) 16424-16436.
O2(B1) + H2 => H + HO2                        ! 3.49d-11*exp(-20500.0d0/Tgas)
O2(B1) + H => OH + O(1D)                      ! 4.38d-10/Tgas**0.03d0*exp(-16210.0d0/Tgas)
O2(B1) + H2O => OH + HO2                      ! 3.40d-9*exp(-27380.0d0/Tgas)
# N.A. Popov, Plasma Sources Sci. Technol. 20 (2011) 045002.
O2(B1) + H2 => O2(A1) + H2                    ! 1.00d-12
# R. Atkinson, et al, Atmos. Chem. Phys. Discuss. 3 (2003) 6179-6699.
O2(B1) + O2 => O2 + O2                        ! 4.1d-17
O2(B1) + H2O => O2(A1) + H2O                  ! 4.6d-12
# A. Starikovskiy and N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
O2(B1) + H2O => O + H2O2                      ! 2.05d-12*Tgas*0.5*exp(-27480.0d0/Tgas)
O2(B1) + HO2 => O2 + HO2                      ! 5.65d-18
O2(B1) + H2O2 => O2 + H2O2                    ! 5.65d-18
# J.K. Lefkowitz, et al., Proc. Combust. Inst. 35 (3) (2015) 3505-3512. 
O2(B1) + OH => O + HO2                        ! 2.16d-11*exp(-10111.0d0/Tgas)
O2(B1) + CO => CO2 + O                        ! 5.25d-13*exp(-12197.0d0/Tgas)
# R.B. Boodaghians, et al., Chem. Phys. Lett. 97 (1983) 193-197.
O2(B1) + NH3 => O2 + NH3                      ! 1.17d-12 

# Reactions of O2*
# I.N. Kosarev, et al., Combustion and Flame 203 (2019) 72-82.
#O2* + CH3OCH3 => O2 + CH3O + CH3            ! 1.0d-10
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O2* + O => O2 + O(1S)                       ! 9.0d-12
O2* + O2 => O2(B1) + O2(B1)                 ! 3.0d-13
O2* + N2 => O2(B1) + N2                     ! 9.0d-15
# A.N. Vasiljeva, et al., J. Phys. D: Appl. Phys. 37 (2004) 2455-2468.
O2* + O => O2 + O                           ! 4.95d-12
O2* + O => O2(A1) + O(1D)                   ! 2.7d-12
O2* + O => O2(B1) + O(1D)                   ! 1.35d-12
O2* + O2 => O2(A1) + O2                     ! 1.86d-13
O2* + O2 => O2(B1) + O2                     ! 2.1d-14
O2* + O2 => O2 + O2                         ! 2.3d-14
# A. Starikovskiy and N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
O2* + H2 => H2 + O2                         ! 7.9d-13
O2* + H2 => H2 + O2(A1)                     ! 8.3d-13
O2* + H2O => H2O + O2 			            ! 4.0d-12       
O2* + HO2 => HO2 + O2                       ! 5.65d-18
O2* + H2O2 => H2O2 + O2                     ! 5.65d-18

#-----------------------------------------------------------------------
#
# Quenching of excited states of O
#
#-----------------------------------------------------------------------

# Reactions of O(1D)
# H. Zhong, et al., J. Phys. Chem. Lett. 2024, 15, 6158−6165.
O(1D) + CH3OCH3 => CH3O + CH3O               ! 3.47d-10*0.78
O(1D) + CH3OCH3 => CH3OCH2 + OH              ! 3.47d-10*0.06
O(1D) + CH3OCH3 => CH3O + CH2OH              ! 3.47d-10*0.16  
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O(1D) + O => O + O                           ! 8.0d-12
O(1D) + O2 => O + O2                         ! 6.4d-12*exp(67.0d0/Tgas)
O(1D) + O2 => O + O2(A1)                     ! 1.0d-12
O(1D) + O2 => O + O2(B1)                     ! 2.6d-11*exp(67.0d0/Tgas)
O(1D) + O3 => O2 + O + O                     ! 1.2d-10
O(1D) + O3 => O2 + O2                        ! 1.2d-10
O(1D) + N2 => O + N2                         ! 2.3d-11
O(1D) + NO => O2 + N                         ! 1.7d-10
O(1D) + N2O => NO + NO                       ! 7.2d-11
O(1D) + N2O => O2 + N2                       ! 4.4d-11
# I.S. Flectcher and D. Husain, Can. J. Chem. 54 (1976) 1765-1770.
O(1D) + H2O2 => HO2 + OH                     ! 5.2d-10
# S. Vranckx, et al., Phys. Chem. Chem. Phys.,12 (2010), 9213-9221.
O(1D) + H2O => OH + OH                       ! 0.99*1.7d-10*exp(36.0d0/Tgas)  
O(1D) + H2O => O + H2O                       ! 0.01*1.7d-10*exp(36.0d0/Tgas)
O(1D) + H2 => OH + H                         ! 0.993*1.35d-10
O(1D) + H2 => O + H2                         ! 0.007*1.35d-10
# W.B. DeMore, et al, Chemical Kinetics and Potochemical Data for Use in Stratospheric Modeling - Evaluation No. 12, JPL Publication 97-4, Jan. 1997.
O(1D) + CO2 => O + CO2                       ! 7.4d-11
# J.A. Davidson, et al, J. Chem. Phys. 69 (1978) 1216-1217.
O(1D) + CO => O + CO                         ! 4.7d-11*exp(-62.4d0/Tgas)
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
O(1D) + OH => H + O2                         ! 6.0d-11/Tgas**0.186*exp(-154.0d0/Tgas)
O(1D) + HO2 => OH + O2                       ! 2.9d-11*exp(200.0d0/Tgas)
# N. Tsolas, R.A. Yetter, I.V. Adamovich, Combust. Flame 176 (2017) 462-478.
O(1D) + CH2O => CO + H2O                     ! 1.66d-10
# Y. Matsumi, et al, J. Phys. Chem. 98 (1994) 3777–3781.
O(1D) + CH3OH => CH3O + OH                      ! 4.2d-10
O(1D) + CH3OH => HOCH2O + H                     ! 0.9d-10

# Reactions of O(1S)
# I.A. Kossyi, et al., Plasma Sources Sci. Technol. 1 (1992) 207-220.
O(1S) + O => O(1D) + O                       ! 5.0d-11*exp(-301.0d0/Tgas)
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O(1S) + N  => O + N                          ! 1.0d-12
O(1S) + O2 => O(1D) + O2                     ! 1.3d-12*exp(-850.0d0/Tgas)
O(1S) + N2 => O + N2                         ! 1.0d-17
O(1S) + O2 => O + O + O                      ! 3.0d-12*exp(-850.0d0/Tgas)
O(1S) + O2(A1) => O + O2*                    ! 1.1d-10
O(1S) + O2(A1) => O(1D) + O2(B1)             ! 2.9d-11
O(1S) + O2(A1) => O + O + O                  ! 3.2d-11
O(1S) + O3 => O2 + O2                        ! 2.9d-10
O(1S) + O3 => O2 + O + O(1D)                 ! 2.9d-10
O(1S) + NO => O + NO                         ! 2.9d-10
O(1S) + NO => O(1D) + NO                     ! 5.1d-10
O(1S) + N2O => O + N2O                       ! 6.3d-12
O(1S) + N2O => O(1D) + N2O                   ! 3.1d-12
# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O(1S) + O => O + O                           ! 3.33d-11*exp(-300.0d0/Tgas)
O(1S) + O2 => O + O2                         ! 1.6d-12*exp(-850.0d0/Tgas)
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
O(1S) + H2 => H + OH                         ! 2.6d-16
O(1S) + OH => H + O2                         ! 6.0d-11/Tgas**0.186*exp(-154.0d0/Tgas)
O(1S) + HO2 => OH + O2                       ! 2.9d-11*exp(200.0d0/Tgas)
O(1S) + H2O => O(1D) + H2O                   ! 1.5d-10
O(1S) + H2O => O + H2O                       ! 4.5d-11  
O(1S) + H2O => OH + OH                       ! 3.0d-10
O(1S) + H2O => H2 + O2                       ! 2.2d-12

#-----------------------------------------------------------------------
#
# quenching of excited states of N2
#
#-----------------------------------------------------------------------

# Reactions of N2(A)
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
N2(A) + N => N2 + N                !  2.0d-12
N2(A) + N2 => N2 + N2              !  3.0d-16 
N2(A) + N2(A) => N2 + N2(B)        !  3.0d-10
N2(A) + N2(A) => N2 + N2(C)        !  1.5d-10
N2(A) + H => N2 + H                !  2.1d-10
N2(A) + H2 => N2 + H + H           !  2.0d-10*exp(-3500.0d0/Tgas)
N2(A) + O => NO + N(2D)            !  7.0d-12
N2(A) + O => N2 + O(1S)            !  2.1d-11    
N2(A) + O2 => N2 + O2(A1)          !  2.0d-13*(Tgas/300.0d0)**0.55   
N2(A) + O2 => N2O + O              !  2.0d-14*(Tgas/300.0d0)**0.55
N2(A) + NO => N2 + NO              !  6.9d-11
N2(A) + N2O => N2 + N + NO         !  1.0d-11
N2(A) + NO2 => N2 + O + NO         !  1.0d-12
N2(A) + H2O => N2 + H + OH         !  5.0d-14
N2(A) + OH => N2 + O + H           !  1.0d-10
# N.A. Popov, Plasma Sources Sci. Technol. 25 (2016) 044003 (17pp).
N2(A) + O2 => N2 + O + O           !  1.7d-12*(Tgas/300.0d0)**0.5
N2(A) + O2 => N2 + O2(B1)          !  7.5d-13*(Tgas/300.0d0)**0.5
# Estimated 
N2(A) + CH3OCH3 => N2 + CH3O + CH3          ! 1.0d-11*0.5
N2(A) + CH3OCH3 => N2 + CH3OCH2 + H         ! 1.0d-11*0.5
N2(A) + CH3OCHO => N2 + CH2O + H + HCO      ! 3.0d-10*0.7
N2(A) + CH3OCHO => N2 + CH2 + H + OCHO      ! 3.0d-10*0.3

# Reactions of N2(B)
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
N2(B) + N2 => N2(A) + N2           !  3.0d-11
N2(B) + N2 => N2 + N2              !  2.0d-12
N2(B) + H2 => N2(A) + H2           !  2.5d-11
N2(B) + NO => N2(A) + NO           !  2.4d-10
N2(B) + O2 => N2 + O + O           !  3.0d-10
# N.A. Popov, Plasma Sources Sci. Technol. 25 (2016) 044003 (17pp).
N2(B) + O => NO + N(2D)            !  3.0d-10
# Estimated 
N2(B) + CH3OCH3 => N2 + CH3O + CH3          ! 5.0d-11*0.5
N2(B) + CH3OCH3 => N2 + CH3OCH2 + H         ! 5.0d-11*0.5
N2(B) + CH3OCHO => N2 + CH2O + H + HCO      ! 3.0d-10*0.7
N2(B) + CH3OCHO => N2 + CH2 + H + OCHO      ! 3.0d-10*0.3

# Reactions of N2(a')
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
N2(a') + N2 => N2(B) + N2          !  1.9d-13
N2(a') + NO => N2 + N + O          !  3.6d-10
N2(a') + H => N2 + H               !  1.5d-10
N2(a') + H2 => N2 + H + H          !  2.6d-11
N2(a') + N2(A)  => N4^+ + E        !  4.0d-12
N2(a') + N2(a') => N4^+ + E        !  1.0d-11
# N.A. Popov, Plasma Sources Sci. Technol. 25 (2016) 044003 (17pp).
N2(a') + O2 => N2 + O + O(1D)      !  2.8d-11
N2(a') + O => NO + N(2D)           !  3.0d-10
# Estimated 
N2(a') + CH3OCH3 => N2 + CH3O + CH3          ! 5.0d-11*0.1
N2(a') + CH3OCH3 => N2 + CH2O + CH3 + H      ! 5.0d-11*0.4
N2(a') + CH3OCH3 => N2 + CH3OCH2 + H         ! 5.0d-11*0.5
N2(a') + CH3OCHO => N2 + CH2O + H + HCO      ! 3.0d-10*0.7
N2(a') + CH3OCHO => N2 + CH2 + H + OCHO      ! 3.0d-10*0.3


# Reactions of N2(C)
# Kobayashi et al., Plasma Sources Sci. Technol. 26 (2017) 075004 (12pp).
N2(C) + H2 => N2 + H + H           !  3.0d-10
# N.A. Popov, Plasma Sources Sci. Technol. 25 (2016) 044003 (17pp).
N2(C) + O2 => N2 + O + O(1D)       !  3.0d-10
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
N2(C) + N2 => N2(a') + N2          !  1.0d-11
# N.A. Popov, Plasma Sources Sci. Technol. 25 (2016) 044003 (17pp).
N2(C) + O => NO + N(2D)            !  3.0d-10
# Estimated 
N2(C) + CH3OCH3 => N2 + CH3O + CH3          ! 1.0d-10*0.1
N2(C) + CH3OCH3 => N2 + CH2O + CH3 + H      ! 1.0d-10*0.4
N2(C) + CH3OCH3 => N2 + CH3OCH2 + H         ! 1.0d-10*0.5
N2(C) + CH3OCHO => N2 + CH2O + H + HCO      ! 5.0d-10*0.7
N2(C) + CH3OCHO => N2 + CH2 + H + OCHO      ! 5.0d-10*0.3

#-----------------------------------------------------------------------
#
# Quenching of excited states of N
#
#-----------------------------------------------------------------------

# Reactions of N(2D)
# Reaction rates are estimated from N(2D) with C2H6 at 296K
# D. Nunez-Reyes et al., Phys. Chem. Chem. Phys. 21 (2019) 6574-6581
# M. Rosi, et al., International Conference on Computational Science and Its Applications; 2012: Springer. p. 331-344
N(2D) + CH3OCH3 => CH2NH + CH2OH            ! 1.2d-11*0.1
N(2D) + CH3OCH3 => CH3OH + HCNH             ! 1.2d-11*0.9

# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
N(2D) + O => N + O(1D)              !  4.0d-13
N(2D) + N2O => NO + N2              !  3.5d-12 
N(2D) + H2 => NH + H                !  2.3d-12

# N.A. Popov, Plasma Sources Sci. Technol. 25 (2016) 044003 (17pp).
N(2D) + O2 => NO + O(1D)            !  7.3d-12*exp(-185.0d0/Tgas)
N(2D) + O2 => NO + O                !  2.4d-12*exp(-185.0d0/Tgas)
N(2D) + O => N + O                  !  1.8d-12
N(2D) + NO => O + N2                !  6.0d-11
N(2D) + NO => O(1D) + N2            !  6.0d-11
N(2D) + N2 => N + N2                !  1.7d-14

#-----------------------------------------------------------------------
#
# Formation of excited states of O2 and N2
#
#-----------------------------------------------------------------------

# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O + O + O2 => O2 + O2(A1)         ! 1.93d-35*(Tgas/300.0d0)**-0.63

# M. Capitelli, et al, Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York.
N + N + @M => N2(A) + @M           !  @R
    @M = N2       O2       NO       N        O
    @R = 1.7d-33  1.7d-33  1.7d-33  1.0d-32  1.0d-32

N + N + @M => N2(B) + @M           !  @R
    @M = N2       O2       NO       N        O
    @R = 2.4d-33  2.4d-33  2.4d-33  1.4d-32  1.4d-32

#-----------------------------------------------------------------------
#
# O3 reactions
#
#-----------------------------------------------------------------------

# A.N. Vasiljeva, et al., J. Phys. D: Appl. Phys. 37 (2004) 2455-2468.
O3 + O => O2 + O2(B1)               ! 8.0d-14*exp(-2060.0d0/Tgas)
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O3 + O => O2 + O2(A1)               ! 1.0d-11*exp(-2300.0d0/Tgas)

#-----------------------------------------------------------------------
#
# Positive ion reactions
#
#-----------------------------------------------------------------------

# Reactions of CH3OCH3^+ 
# Estimated from V.G. Anicich, J. Phys. Chem. Ref. Data 22 (1993) 1469-1569.
CH3OCH3^+ + H2O => H3O^+ + CH3OCH2        ! 2.95d-9

# Reactions of O2^+
# UMIST RATE22, astrochemistry.net.
O2^+ + CH3OCH3 => O2 + CH3OCH3^+          ! 4.5d-10*(300.0d0/Tgas)**0.5
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O2^+ + O2 + O2 => O4^+ + O2               ! 2.4d-30*(300.0d0/Tgas)**3.2

# Reactions of O4^+
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O4^+ + O => O2^+ + O3                    ! 3.0d-10
O4^+ + O2 => O2^+ + O2 + O2              ! 3.3d-6*(300.0d0/Tgas)**4*exp(-5030.0d0/Tgas)
# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O4^+ + O(1D) => O2^+ + O3                ! 3.0d-10
O4^+ + O(1S) => O2^+ + O3                ! 3.0d-10

# Reactions of N2^+
# Estimated from V.G. Anicich, J. Phys. Chem. Ref. Data 22 (1993) 1469-1569.
#N2^+ + CH3OCH3 => N2 + CH3OCH3^+         ! 1.0d-9
N2^+ + CH3OCH3 => N2 + CH3OCH3^+         ! 2.0d-9
# UMIST RATE12, astrochemistry.net.
N2^+ + H2O => H2O^+ + N2                ! 2.3d-9*(300.0d0/Tgas)**0.5
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
N2^+ + O2 => O2^+ + N2                   ! 6.0d-11*(300.d0/Tgas)**0.5d0
N2^+ + N2 + N2 => N4^+ + N2              ! 5.2d-29*(300.0d0/Tgas)**2.2

# Reactions of N4^+
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
N4^+ + O2 => O2^+ + N2 + N2              ! 2.5d-10
N4^+ + N2 => N2^+ + N2 + N2              ! 2.1d-16*exp(Tgas/121.0d0)
N4^+ + H2O => H2O^+ + N2 + N2           ! 3.0d-9

# Reactions of H2O^+
# UMIST RATE12, astrochemistry.net.
H2O^+ + O => O2^+ + H2                  ! 4.0d-11
H2O^+ + OH => H3O^+ + O                 ! 6.9d-10*(300.0d0/Tgas)**0.5
H2O^+ + O2 => O2^+ + H2O                ! 4.6d-10
H2O^+ + H2O => H3O^+ + OH               ! 2.1d-9*(300.0d0/Tgas)**0.5
# UMIST RATE22, astrochemistry.net.
H2O^+ + CH4 => H3O^+ + CH3              ! 1.4d-9
H2O^+ + H2 => H3O^+ + H                 ! 9.7d-10
H2O^+ + HCO => H3O^+ + CO               ! 2.8d-10*(300.0d0/Tgas)**0.5
H2O^+ + NH => H3O^+ + N                 ! 7.1d-10*(300.0d0/Tgas)**0.5

# Reactions of H3O^+
# UMIST RATE22, astrochemistry.net.
H3O^+ + CH3OCH2 => CH3OCH3^+ + H2O      ! 1.52d-9*(300.0d0/Tgas)**0.5

#-----------------------------------------------------------------------
#
# Negative ion reactions
#
#-----------------------------------------------------------------------

# Reactions of O^- 
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O^- + O => O2 + E                       ! 1.4d-10
O^- + O2 => O3 + E                      ! 5.0d-15
O^- + O3 => O2 + O2 + E                 ! 3.0d-10
O^- + N => NO + E                       ! 2.6d-10
O^- + NO => NO2 + E                     ! 2.6d-10
O^- + N2 => N2O + E                     ! 5.0d-13
O^- + O2(A1) => O3 + E                  ! 3.0d-10
O^- + O2(A1) => O2^- + O                ! 1.0d-10
O^- + O2(B1) => O + O2 + E              ! 6.9d-10
O^- + N2(A) => O + N2 + E               ! 2.2d-9
O^- + N2(B) => O + N2 + E               ! 1.9d-9
# UMIST RATE12, astrochemistry.net.
O^- + CH2 => CH2O + E                   ! 5.00d-10
O^- + CH => HCO + E                     ! 5.00d-10
O^- + C => CO + E           	        ! 5.00d-10
O^- + CO => CO2 + E                     ! 6.50d-10
O^- + H2 => H2O + E                     ! 7.00d-10
O^- + H => OH + E                       ! 5.00d-10
O^- + O2 => O + O2^-                    ! 7.3d-10*exp(-890.0d0/Tgas)
# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O^- + O3 => O2^- + O2                   ! 1.02d-11*(Tgas/300.0d0)**0.5
O^- + O(1D) => O2 + E                   ! 1.0d-10
O^- + O(1S) => O2 + E                   ! 1.0d-10
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
O^- + H2O => H2O2 + E                   ! 6.0d-13
# A. Starikovskiy and N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
O^- + OH => HO2 + E                     ! 1.0d-9
O^- + HO2 => OH + O2 + E                ! 1.0d-9
O^- + H2O2 => H2O + O2 + E              ! 1.0d-9

# Reactions of O2^-
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O2^- + O => O3 + E                      ! 1.5d-10
O2^- + O => O^- + O2                    ! 3.3d-10
O2^- + O2 => E + O2 + O2                ! 2.7d-10*(Tgas/300.0d0)**0.5*exp(-5590.0d0/Tgas)
O2^- + O2(A1) => O2 + O2 + E            ! 2.0d-10
O2^- + O2(B1) => O2 + O2 + E            ! 3.6d-10
O2^- + N2 => O2 + N2 + E                ! 1.9d-12*(Tgas/300.0d0)**0.5*exp(-4990.0d0/Tgas)
O2^- + N => NO2 + E                     ! 5.0d-10
O2^- + N2(A) => O2 + N2 + E             ! 2.1d-9
O2^- + N2(B) => O2 + N2 + E             ! 2.5d-9
# I.A. Kossyi, et al, Plasma Sources Sci. Technol. 1 (1992) 207-220.
O2^- + O2 + O2 => O4^- + O2             ! 3.5d-31*(300.0d0/Tgas)
# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O2^- + O(1D) => O + O2 + E              ! 1.0d-10
O2^- + O(1S) => O + O2 + E              ! 1.0d-10
O2^- + O(1S) => O^- + 2O                ! 1.0d-10
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
O2^- + H => HO2 + E                     ! 1.50d-9
O2^- + H2O => O2 + H2O + E              ! 5.0d-9*exp(-5000.0d0/Tgas)

# Reactions of O4^-
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O4^- + O => O^- + O2 + O2               ! 3.0d-10
O4^- + O2(A1) => O2^- + O2 + O2         ! 1.0d-10
O4^- + O2(B1) => O2^- + O2 + O2         ! 1.0d-10
# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O4^- + O(1D) => O + 2O2 + E             ! 1.0d-10
O4^- + O(1S) => O + 2O2 + E             ! 1.0d-10
O4^- + O2(B1) => 3O2 + E                ! 1.0d-10
O4^- + ANY_NEUTRAL => O2^- + O2 + ANY_NEUTRAL   !  1.0d-10*exp(-1044.0d0/Tgas)
O4^- + O(1D) => O2^- + O2 + O           ! 1.0d-10
O4^- + O(1S) => O^- + 2O2               ! 1.0d-10

# Reactions of OH^-
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
OH^- + NO => HNO2 + E                   ! 1.0d-9
# UMIST RATE12, astrochemistry.net.
OH^- + H => H2O + E                     ! 1.4d-9
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
OH^- + O => HO2 + E                     ! 2.0d-10
# UMIST RATE22, astrochemistry.net.
OH^- + C => HCO + E                     ! 5.0d-10
OH^- + CH3 => CH3OH + E                 ! 1.0d-9
OH^- + CH => CH2O + E                   ! 5.0d-10

#-----------------------------------------------------------------------
#
# Ion-ion Recombination 
#
#----------------------------------------------------------------------

# Reactions of O^-
# UMIST RATE12, astrochemistry.net.
O^- + H3O^+ => O + H + H2O             ! 7.51d-8*(300.0d0/Tgas)**0.5
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O^- + O2^+ => O + O2                   ! 2.0d-7*(300.0d0/Tgas)**0.5
O^- + N2^+ => O + N2                   ! 2.0d-7*(300.0d0/Tgas)**0.5 
O^- + @A => O + @B                     ! 1.0d-7
    @A = N2^+  N4^+  O2^+  O4^+  
    @B = N+N   N2+N2 O+O   O2+O2 
O^- + @A + ANY_NEUTRAL => O + @B + ANY_NEUTRAL    ! 2.0d-25*(300.0d0/Tgas)**2.5
    @A = N2^+  O2^+   O4^+ 
    @B = N2    O2     O2+O2
O^- + N2^+ + ANY_NEUTRAL => N2O + ANY_NEUTRAL     ! 2.0d-25*(300.0d0/Tgas)**2.5 
O^- + O2^+ + ANY_NEUTRAL => O3 + ANY_NEUTRAL      ! 2.0d-25*(300.0d0/Tgas)**2.5        
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
O^- + H3O^+ => H2O + OH                ! 2.0d-7*(300.0d0/Tgas)**0.5

# Reactions of O2^-
# UMIST RATE12, astrochemistry.net.
O2^- + H3O^+ => O2 + H + H2O           ! 7.51d-8*(300.0d0/Tgas)**0.5
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O2^- + O2^+ => O2 + O2                 ! 2.0d-7*(300.0d0/Tgas)**0.5 
O2^- + N2^+ => O2 + N2                 ! 2.0d-7*(300.0d0/Tgas)**0.5  
O2^- + @A => O2 + @B                   ! 1.0d-7
    @A = N2^+  N4^+  O2^+  O4^+ 
    @B = N+N   N2+N2 O+O   O2+O2 
O2^- + @A  + ANY_NEUTRAL => O2 + @B + ANY_NEUTRAL ! 2.0d-25*(300.0d0/Tgas)**2.5
    @A = N2^+  O2^+   O4^+ 
    @B = N2    O2     O2+O2
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
O2^- + H2O^+ => O2 + H2O               ! 2.0d-7*(300.0d0/Tgas)**0.5

# Reactions of O4^-
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York, 2000.
O4^- + @A => 2O2 + @B                  ! 1.0d-7
    @A = N2^+  N4^+   O2^+   O4^+   
    @B = N2    N2+N2  O2     O2+O2 
# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O4^- + @A + ANY_NEUTRAL => 2O2 + @B + ANY_NEUTRAL  ! 2.0d-25*(300.0d0/Tgas)**2.5
    @A = O2^+   O4^+
    @B = O2     O2+O2

# Reactions of OH^-
# UMIST RATE12, astrochemistry.net.
OH^- + H3O^+ => OH + H + H2O          ! 7.51d-8*(300.0d0/Tgas)**0.5
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
OH^- + O2^+ => OH + O2                ! 2.0d-7*(300.0d0/Tgas)**0.5
OH^- + H2O^+ => OH + H2O              ! 2.0d-7*(300.0d0/Tgas)**0.5
OH^- + H2O^+ + ANY_NEUTRAL => OH + H2O + ANY_NEUTRAL ! 2.0d-25*(Tgas/300.0d0)**-2.5
OH^- + H3O^+ => 2H2O                  ! 4.0d-7*(300.0d0/Tgas)**0.5	
END
