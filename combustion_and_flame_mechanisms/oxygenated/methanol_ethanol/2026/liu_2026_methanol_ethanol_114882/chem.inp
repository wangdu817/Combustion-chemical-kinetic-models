####  Electronial excited state of O2
#optical transitions and predissociation 
# M. Capitelli, et al, Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York.
O2(A1)=>O2                                ! 2.6d-4
O2(B1)=>O2(A1)                            ! 1.5d-3
O2(B1)=>O2                                ! 8.5d-2
O2*=>O2                                   ! 11.0d0

# A. Starikovskiy, N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017. 
O(1D)=>O                                  ! 7.0d-3
O(1S)=>O                                  ! 1.34d0

#reaction of O2(A1) 
# K.H.Becker, et al. Chem. Phys. Lett. 8 (1971) 259-262.
O2(A1)+CH4=>O2+CH4                        ! 1.4d-18

# S.W. Mayer, et al. J. Phys. Chem. 72 (1968) 2628-2631.
#O2(A1)+CH4=>CH3+HO2                      ! 6.14d-12*exp(-1.79d4/Tgas)

# A. Hicks et al, J. Phys. D: Appl. Phys. 38 (20) (2005) 3812-3824.	
O2(A1)+O+O2=>O2+O+O2                      ! 1.0d-32

# M. Capitelli, et al, Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, New York.
O2(A1)+O=>O2+O                            ! 7.0d-16
O2(A1)+O2=>O2+O2                          ! 3.8d-18*exp(-205.0d0/Tgas)
O2(A1)+O3=>O2+O2+O(1D)                    ! 5.2d-11*exp(-2840.0d0/Tgas)
O2(A1)+O2(A1)=>O2+O2(B1)                  ! 7.0d-25*Tgas**3.8*exp(700.0d0/Tgas)
O2(A1)+N=>NO+O                            ! 2.0d-14*exp(-600.0d0/Tgas)
O2(A1)+N2=>O2+N2                          ! 3.0d-21
O2(A1)+NO=>O2+NO                          ! 2.5d-17

# J.K. Lefkowitz, et al, Proc. Combust. Inst. 35 (3) (2015) 3505-3512. 
O2(A1)+H=>OH+O                            ! 1.83d-10*exp(-3188.0d0/Tgas)
O2(A1)+H2=>H+HO2                          ! 3.49d-11*exp(-18126.0d0/Tgas)  
O2(A1)+OH=>O+HO2                          ! 2.16d-11*exp(-17132.0d0/Tgas)
#O2(A1)+CO=>CO2+O                         ! 5.25d-13*exp(-14446.0d0/Tgas)

# N. Tsolas, R.A. Yetter, I.V. Adamovich, Combust. Flame 176 (2017) 462-478.
O2(A1)+H=>H+O2                            ! 8.78d-14*Tgas**6.8d-1*EXP(-2.82d03/Tgas)
O2(A1)+H2=>OH+OH                          ! 2.80d-09*exp(-17900.0d0/Tgas)
O2(A1)+H2O=>O2+H2O                        ! 5.00d-18
O2(A1)+H2O=>OH+HO2                        ! 3.40d-10*exp(-28200.d0/Tgas)
O2(A1)+CO2=>O2+CO2                        ! 2.00d-20
#O2(A1)+CH3=>CH3O2                        ! 2.76d-07/Tgas**2.71d0*exp(-4330.d0/Tgas)
#O2(A1)+CH3=>CH2O+OH                      ! 5.76d-17*Tgas**1.63d0*exp(-3470.0d0/Tgas)
#O2(A1)+CH3=>CH3O+O                       ! 1.70d-20*Tgas**2.68d0*exp(-3350.0d0/Tgas)
O2(A1)+CH2O=>HO2+HCO                      ! 1.66d-10*exp(-11600.0d0/Tgas)

# L.B. Ibraguimova, et al., Institute of Mechanics of Lomonosov, Moscow State University, 2003.
O2(A1)+OH=>O2+OH                          ! 5.65d-18
O2(A1)+H2O2=>O2+H2O2                      ! 5.65d-18

# A. Starikovskiy and N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
O2(A1)+H2O=>O+H2O2                        ! 2.05d-12*Tgas**0.5*exp(-35100.d0/Tgas)

# Combust. Flame 240 (2022) 111990
O2(A1)+H2=>O2+H2                          ! 4.5d-18*(Tgas/300.0d0)**0.5
O2(A1)+HO2=>O2+HO2                        ! 5.65d-18
O+O3=>O2+O2(A1)                           ! 1.0000d-11*EXP(-2.3000d+03/Tgas)

