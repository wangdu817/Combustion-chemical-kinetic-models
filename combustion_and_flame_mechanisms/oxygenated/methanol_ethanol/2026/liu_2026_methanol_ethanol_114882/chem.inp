#********************************************************************************#
#                      electron impact reaction                                  #
#                      Phelps database, www.lxcat.net                            #
#********************************************************************************#

# Electron impact O2
#E + O2 => E + O2                            ! BOLSIG O2->O2(rot)

E + O2 => E + O2(v1)                        ! BOLSIG O2->O2(v1res)
E + O2 => E + O2(v1)                        ! BOLSIG O2->O2(v1)
E + O2 => E + O2(v2)                        ! BOLSIG O2->O2(v2res)
E + O2 => E + O2(v2)                        ! BOLSIG O2->O2(v2)
E + O2 => E + O2(v3)                        ! BOLSIG O2->O2(v3)
E + O2 => E + O2(v4)                        ! BOLSIG O2->O2(v4)

E + O2 => E + O2(A1)                        ! BOLSIG O2->O2(A1)
E + O2 => E + O2(B1)                        ! BOLSIG O2->O2(B1)
E + O2 => E + O2*                           ! BOLSIG O2->O2(A3)

E + O2 => E + O + O                         ! BOLSIG O2->O+O
E + O2 => E + O + O(1D)                     ! BOLSIG O2->O(1D)
E + O2 => E + O + O(1S)                     ! BOLSIG O2->O(1S)

E + O2 => E + E + O2^+                      ! BOLSIG O2->O2^+
E + O2 => O^- + O                           ! BOLSIG O2->O^-
E + O2 => O2^-                              ! BOLSIG O2->O2^-

# Electron impact N2
#E + N2 => E + N2                              ! BOLSIG  N2 -> N2(rot)

E + N2 => E + N2(v1)                          ! BOLSIG  N2 -> N2(v1res)
E + N2 => E + N2(v1)                          ! BOLSIG  N2 -> N2(v1)
E + N2 => E + N2(v2)                          ! BOLSIG  N2 -> N2(v2)
E + N2 => E + N2(v3)                          ! BOLSIG  N2 -> N2(v3)
E + N2 => E + N2(v4)                          ! BOLSIG  N2 -> N2(v4)
E + N2 => E + N2(v5)                          ! BOLSIG  N2 -> N2(v5)
E + N2 => E + N2(v6)                          ! BOLSIG  N2 -> N2(v6)
E + N2 => E + N2(v7)                          ! BOLSIG  N2 -> N2(v7)
E + N2 => E + N2(v8)                          ! BOLSIG  N2 -> N2(v8)

E + N2 => E + N2(A)                           ! BOLSIG N2 -> @R
   @R = N2(A3,v0-4)  N2(A3,v5-9)  N2(A3,v10-)
E + N2 => E + N2(B)                           ! BOLSIG N2 -> @R
   @R = N2(B3)   N2(W3)  N2(B'3)
E + N2 => E + N2(a')                          ! BOLSIG N2 -> @R
   @R = N2(a'1)  N2(a1)  N2(w1)
E + N2 => E + N2(C)                           ! BOLSIG N2 -> @R
   @R = N2(C3)   N2(E3)   N2(a''1) 

E + N2 => E + N + N(2D)                       ! BOLSIG N2 -> N + N(2D)

E + N2 => 2E + N2^+                           ! BOLSIG N2 -> N2^+

#********************************************************************************#
#                      electron impact reaction                                  #
#                      Morgan database, www.lxcat.net                            #
#********************************************************************************#

E + O => E + O(1D)                            ! BOLSIG O->O(1D)
E + O => E + O(1S)                            ! BOLSIG O->O(1S)
E + O => E + O^+ + E                          ! BOLSIG O->O^+


#********************************************************************************#
#                      electron impact reaction                                  #
#                      TRINITI database, www.lxcat.net                           #
#********************************************************************************#

E + H2O => E + H2O                            ! BOLSIG H2O -> H2O(rot)
E + H2O => E + H2O                            ! BOLSIG H2O -> H2O(010)
E + H2O => E + H2O                            ! BOLSIG H2O -> H2O(101)
E + H2O => E + H + OH                         ! BOLSIG H2O -> H + OH
E + H2O => E + E + H2O^+                      ! BOLSIG H2O -> H2O^+
E + H2O => H2 + O^-                           ! BOLSIG H2O -> H2 + O^-
E + H2O => OH + H^-                           ! BOLSIG H2O -> OH + H^-

# Electron impact CH3OH
# R-matrix method
E + CH3OH => E + CH3OH                        ! BOLSIG CH3OH -> @R
   @R = CH3OH(rot1) CH3OH(rot2) CH3OH(rot3) CH3OH(rot4) CH3OH(rot5)

E + CH3OH => E + CH3OH                        ! BOLSIG CH3OH -> CH3OH(v)
E + CH3OH => E + CH3OH(e1)                    ! BOLSIG CH3OH -> CH3OH(e1)
E + CH3OH => E + CH3OH(e2)                    ! BOLSIG CH3OH -> CH3OH(e2)
E + CH3OH => E + CH3OH(e3)                    ! BOLSIG CH3OH -> CH3OH(e3)
E + CH3OH => E + CH3O+H                       ! BOLSIG CH3OH -> CH3O + H
E + CH3OH => E + CH3+OH                       ! BOLSIG CH3OH -> CH3 + OH
E + CH3OH => E + CH2OH+H                      ! BOLSIG CH3OH -> CH2OH + H

#estimated
E + CH3OH => E + HCO + H2 + H                 ! 0.455*BOLSIG CH3OH -> CH3O + H
E + CH3OH => E + CH2O + H2                    ! 0.150*BOLSIG CH3OH -> CH3O + H

#total ionization cross section
E + CH3OH => E + CH3OH^+ + E                  ! BOLSIG CH3OH -> CH3OH^+                
# partical ionization cross section
# coefficient was from the Ref. Physics Reports 466(2008) 1-103.
# function was fitting in the range of 13-1000 eV
# coefficient was from the Ref. Physics Reports 466(2008) 1-103.
E + CH3OH => E + E + CH3O^+ + H               ! BOLSIG CH3OH -> CH3OH^+

# Electron impact CH2O
# Electron-impact study of formaldehyde using the R-matrix method,J. Phys. B: At. Mol. Opt. Phys. 38 (2005) 3917–3933
# Elastic, momentum transfer, excitation
E + CH2O => E + CH2O                          ! BOLSIG CH2O -> CH2O
#E + CH2O => E + CH2O                         ! BOLSIG CH2O -> CH2O(3A2)
#Estimated
E + CH2O => E + CO + H + H                   ! 800*BOLSIG CH2O -> CH2O(3A2)
#estimated
E + CH2O => E + CO + H2                      ! 1000*BOLSIG CH2O -> CH2O(1A2)

# Ionization
# Electron impact ionization of formaldehyde, Chemical Physics Letters 476 (2009) 178–181
E + CH2O => E + E + CH2O^+                    ! BOLSIG CH2O -> CH2O^+
E + CH2O => E + E + H2 + CO^+                 ! BOLSIG CH2O -> CO^+

###Reactions of O2(v)
# SSH theory and approximations for the Morse oscillator model.
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
# A. Starikovskiy and N. Aleksandrov, Prog. Energy Combust. Sci. 39 (1) (2013) 61-110.
O2(v1) + N2 => O2 + N2                   ! kVT10_O2N2 
O2(v2) + N2 => O2(v1) + N2               ! kVT10_O2N2*2.015*exp(1.45d0*(14.9d0/Tgas)**0.5) 
O2(v3) + N2 => O2(v2) + N2               ! kVT10_O2N2*3.047*exp(2.90d0*(14.9d0/Tgas)**0.5)  
O2(v4) + N2 => O2(v3) + N2               ! kVT10_O2N2*4.094*exp(4.35d0*(14.9d0/Tgas)**0.5)  

O2(v1) + O2 => O2 + O2                   ! kVT10_O2O2 
O2(v2) + O2 => O2(v1) + O2               ! kVT10_O2O2*2.015*exp(1.45d0*(16.0d0/Tgas)**0.5) 
O2(v3) + O2 => O2(v2) + O2               ! kVT10_O2O2*3.047*exp(2.90d0*(16.0d0/Tgas)**0.5)  
O2(v4) + O2 => O2(v3) + O2               ! kVT10_O2O2*4.094*exp(4.35d0*(16.0d0/Tgas)**0.5)  

O2(v1) + H2O => O2 + H2O                 ! kVT10_O2H2O 
O2(v2) + H2O => O2(v1) + H2O             ! kVT10_O2H2O*2.015*exp(1.45d0*(11.52d0/Tgas)**0.5) 
O2(v3) + H2O => O2(v2) + H2O             ! kVT10_O2H2O*3.047*exp(2.90d0*(11.52d0/Tgas)**0.5)  
O2(v4) + H2O => O2(v3) + H2O             ! kVT10_O2H2O*4.094*exp(4.35d0*(11.52d0/Tgas)**0.5) 

O2(v1) + H2 => O2 + H2                   ! kVT10_O2H2
O2(v2) + H2 => O2(v1) + H2               ! kVT10_O2H2*2.015*exp(1.45d0*(1.882d0/Tgas)**0.5) 
O2(v3) + H2 => O2(v2) + H2               ! kVT10_O2H2*3.047*exp(2.90d0*(1.882d0/Tgas)**0.5)
O2(v4) + H2 => O2(v3) + H2               ! kVT10_O2H2*4.094*exp(4.35d0*(1.882d0/Tgas)**0.5)

O2(v1) + OH => O2 + OH                   ! kVT10_O2OH
O2(v2) + OH => O2(v1) + OH               ! kVT10_O2OH*2.015*exp(1.45d0*(11.102d0/Tgas)**0.5) 
O2(v3) + OH => O2(v2) + OH               ! kVT10_O2OH*3.047*exp(2.90d0*(11.102d0/Tgas)**0.5)
O2(v4) + OH => O2(v3) + OH               ! kVT10_O2OH*4.094*exp(4.35d0*(11.102d0/Tgas)**0.5)

O2(v1) + H => O2 + H                     ! kVT10_O2H
O2(v2) + H => O2(v1) + H                 ! kVT10_O2H*2.015*exp(1.45d0*(9.697d-1/Tgas)**0.5) 
O2(v3) + H => O2(v2) + H                 ! kVT10_O2H*3.047*exp(2.90d0*(9.697d-1/Tgas)**0.5)
O2(v4) + H => O2(v3) + H                 ! kVT10_O2H*4.094*exp(4.35d0*(9.697d-1/Tgas)**0.5)

O2(v1) + O => O2 + O                     ! kVT10_O2O
O2(v2) + O => O2(v1) + O                 ! kVT10_O2O*2.015*exp(1.45d0*(10.667d0/Tgas)**0.5) 
O2(v3) + O => O2(v2) + O                 ! kVT10_O2O*3.047*exp(2.90d0*(10.667d0/Tgas)**0.5)
O2(v4) + O => O2(v3) + O                 ! kVT10_O2O*4.094*exp(4.35d0*(10.667d0/Tgas)**0.5)

O2(v1) + CO2 => O2 + CO2                 ! kVT10_O2CO2
O2(v2) + CO2 => O2(v1) + CO2             ! kVT10_O2CO2*2.015*exp(1.45d0*(18.526d0/Tgas)**0.5) 
O2(v3) + CO2 => O2(v2) + CO2             ! kVT10_O2CO2*3.047*exp(2.90d0*(18.526d0/Tgas)**0.5)
O2(v4) + CO2 => O2(v3) + CO2             ! kVT10_O2CO2*4.094*exp(4.35d0*(18.526d0/Tgas)**0.5)

O2(v1) + CH3OH => O2 + CH3OH             ! kVT10_O2CH3OH
O2(v2) + CH3OH => O2(v1) + CH3OH         ! kVT10_O2CH3OH*2.015*exp(1.45d0*(16.000d0/Tgas)**0.5) 
O2(v3) + CH3OH => O2(v2) + CH3OH         ! kVT10_O2CH3OH*3.047*exp(2.90d0*(16.000d0/Tgas)**0.5)
O2(v4) + CH3OH => O2(v3) + CH3OH         ! kVT10_O2CH3OH*4.094*exp(4.35d0*(16.000d0/Tgas)**0.5)


#### Vibrational-Vibrational (V-V) interactions

# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
# V-V reactions of O2
O2(v1) + O2(v1) => O2 + O2(v2)         ! kVV10_O2O2*2.015*exp(6.378d0/Tgas**0.5)
O2(v1) + O2(v2) => O2 + O2(v3)         ! kVV10_O2O2*3.047*exp(12.756d0/Tgas**0.5)
O2(v1) + O2(v3) => O2 + O2(v4)         ! kVV10_O2O2*4.094*exp(19.134d0/Tgas**0.5)

O2(v2) + O2 => O2(v1) + O2(v1)         ! kVV10_O2O2*2.015*exp(6.378d0/Tgas**0.5)
O2(v2) + O2(v2) => O2(v1) + O2(v3)     ! kVV10_O2O2*6.14*exp(6.378d0/Tgas**0.5)
O2(v2) + O2(v3) => O2(v1) + O2(v4)     ! kVV10_O2O2*8.251*exp(12.756d0/Tgas**0.5)

O2(v3) + O2 => O2(v2) + O2(v1)         ! kVV10_O2O2*3.047*exp(12.756d0/Tgas**0.5)
O2(v3) + O2(v1) => O2(v2) + O2(v2)     ! kVV10_O2O2*6.14*exp(6.378d0/Tgas**0.5)
O2(v3) + O2(v3) => O2(v2) + O2(v4)     ! kVV10_O2O2*12.472*exp(6.378d0/Tgas**0.5)
 
O2(v4) + O2 => O2(v3) + O2(v1)         ! kVV10_O2O2*4.094*exp(19.134d0/Tgas**0.5)
O2(v4) + O2(v1) => O2(v3) + O2(v2)     ! kVV10_O2O2*8.251*exp(12.756d0/Tgas**0.5)
O2(v4) + O2(v2) => O2(v3) + O2(v3)     ! kVV10_O2O2*12.472*exp(6.378d0/Tgas**0.5)

#### Chemical reaction of O2(v)
# calculated by the theory in A. Fridman, Plasma chemistry, Cambridge University Press, New York, 2008.
O2(v1) + H => OH + O                   ! 1.66d-10*exp(-5421.1d0/Tgas)
O2(v2) + H => OH + O                   ! 1.66d-10*exp(-3146.7d0/Tgas)
O2(v3) + H => OH + O                   ! 1.66d-10*exp(-872.2d0/Tgas)
O2(v4) + H => OH + O                   ! 1.66d-10

O2(v1) + H2NO => HNO + HO2             ! 3.82d-22*Tgas**2.994*exp(-6640.3d0/Tgas) 
O2(v2) + H2NO => HNO + HO2             ! 3.82d-22*Tgas**2.994*exp(-4973.9d0/Tgas)
O2(v3) + H2NO => HNO + HO2             ! 3.82d-22*Tgas**2.994*exp(-3307.4d0/Tgas)
