#E+CH3OH^+=>CH2O+H+H                       ! 8.61d-07*(300.0d0/Te)**0.66
E+CH3OH^+=>CH3+OH                          ! 3.00d-07*(300.0d0/Te)**0.50
#E+CH3OH^+=>CH+H2O+H                       ! 6.49d-07*(300.0d0/Te)**0.66
#Estimated
E+CH3OH^+=>CH3O+H                          ! 6.49d-07*(300.0d0/Te)**0.66
E+CH3OH^+=>CH2OH+H                         ! 8.61d-07*(300.0d0/Te)**0.66

# Reactions of CH3O^+
CH3O^++H=>CH2O^++H2                        ! 1.70d-09
CH3O^++H2O=>H3O^++CH2O                     ! 1.70d-09

## UMIST
#E+CH3O^+=>CH3+O                           ! 1.00d-09
E+CH3O^+=>CH2+OH                           ! 4.20d-08*(300.0d0/Tgas)**0.78
E+CH3O^+=>CH+H2O                           ! 1.40d-08*(300.0d0/Tgas)**0.78
E+CH3O^+=>CO+H2+H                          ! 2.10d-07*(300.0d0/Tgas)**0.78
E+CH3O^+=>CH2O+H                           ! 2.17d-07*(300.0d0/Tgas)**0.78

# Reactions of CH2O^+
CH2O^++H2=>CH3O^++H                        ! 1.70d-08*exp(-6550.0d0/Tgas)
 
#UMIST 
CH2O^++N2=>N2^++CH2O                       ! 3.77d-10*(300.0d0/Tgas)**0.50
CH2O^++E=>CH2+O                            ! 2.50d-08*(300.0d0/Tgas)**0.70
CH2O^++E=>CO+H2                            ! 7.50d-08*(300.0d0/Tgas)**0.70
CH2O^++E=>CO+H+H                           ! 2.50d-07*(300.0d0/Tgas)**0.70
CH2O^++E=>HCO+H                            ! 1.60d-07*(300.0d0/Tgas)**0.70
CH2O^++O2=>O2^++CH2O                       ! 3.77d-10*(300.0d0/Tgas)**0.50
CH2O^++CH3OH=>CH3OH^++CH2O                 ! 3.77d-10*(300.0d0/Tgas)**0.50
CH2O^++E=>CH2O                             ! 1.10d-10*(300.0d0/Tgas)**0.70

# Reactions of HCO^+
# Ion-netural reaction-rate constants measured in flow reactors through 1977, Atomic data and nuclear data tables 22, 1-101(1978)
HCO^+ + CH2O => CH3O^+ + co                ! 3.2d-09
HCO^+ + H2O => H3O^+ + CO                  ! 2.5d-09 
HCO^+ + N2 => HCO + N2^+                   ! 5.0d-14

# Reactions of CO^+
# Ion-netural reaction-rate constants measured in flow reactors through 1977, Atomic data and nuclear data tables 22, 1-101(1978)
CO^+ + CH2O => HCO^+ + HCO                 ! 3.0d-09
CO^+ + CH2O => CH2O^+ + CO                 ! 3.0d-09
#CO^+ + CH4 => HCO^+ + CH3                 ! 1.3d-09
#CO^+ + CH4 => CH4^+ + CO                  ! 1.3d-09
CO^+ + H2 => HCO^+ + H                     ! 1.8d-09
CO^+ + H2O => H2O^+ + CO                   ! 2.0d-09

# REACTIONS OF O^+
O^++O2=>O+O2^+                             ! 2.0d-11
O^++N2=>NO+N^+                             ! 1.0d-12*exp(-47900.0d0/Tgas)
O^++H2O=>O+H2O^+                           ! 3.2d-09
O^++CH3OH=>O+CH3OH^+                       ! 4.75d-10*(Tgas/300.0d0)**-0.5d0
O^++CH3OH=>OH+CH3O^+                       ! 1.33d-09

# REACTIONS OF O2^+
#L. Cheng, N. Barleon, B. Cuenot, O. Vermorel, A. Bourdon. Combustion and flame, 240(2022) 111990.
E+O2^++E=>O2+E                             ! 1.0d-25*(300.0d0/Te)**4.5
O2^++O2+N2=>N2+O4^+                        ! 1.80d-28*(300.0d0/Te)**0.75d0
O2^++O2+O2=>O2+O4^+                        ! 2.00d-22*(300.0d0/Te)**3.20d0
O2^++O2+H2O=>H2O+O4^+                      ! 1.50d-29
O2^++O=>O2+O^+                             ! 6.0d-12*Exp(-16500.0d0/Tgas)
O2^++CH3OH=>O2+CH3OH^+                     ! 5.0d-10*(Tgas/300.0d0)**-0.5d0

#NIST
O2^++CH2O=>CH2O^++O2                       ! 2.07d-09*(Tgas/300.0d0)**-0.50d0

#REACTIONS OF O4^+
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
E+O4^+=>O2+O2                              ! 1.4d-6*(300.0d0/Te)**0.5
# Reactions of O4^+
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
O4^+ + O => O2^+ + O3                      ! 3.0d-10
O4^+ + O2 => O2^+ + O2 + O2                ! 3.3d-6*(300.0d0/Tgas)**4*exp(-5030.0d0/Tgas)

# N^+ reactions
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000
N^++N2+N2=>N3^++N2                         ! 1.7d-29*(300.0d0/Tgas)**2.1
N^++N+ANY_NEUTRAL=>N2^+ +ANY_NEUTRAL       ! 1.0d-29
N^++O=>N+O^+                               ! 1.0d-12
N^++O2=>N+O2^+                             ! 5.8d-10
N^++O2=>NO+O^+                             ! 2.8d-11
N^++H2O=>H2O^++N                           ! 2.8d-09
#NIST                                      
N^++CH2O=>CH2O^++N                         ! 1.88d-09*(Tgas/300.0d0)**-0.50

# N2^+ reactions
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000
N2^++N2+N2=>N4^++N2                        ! 5.2d-29*(300.0d0/Tgas)**2.2
N2^++N+N2=>N3^++N2                         ! 9.0d-30*exp(400.0d0/Tgas)
N2^++N=>N^++N2                             ! 7.2d-13*(Tgas/300.0d0)

# UMIST
N2^++CH3OH=>N2+CH3OH^+                     ! 1.0d-11
N2^++O2=>N2+O2^+                           ! 6.0d-11*(300.0d0/Tgas)**0.50d0
N2^++O=>N2+O^+                             ! 1.0d-11*(300.0d0/Tgas)**0.50d0

# UMIST RATE12, astrochemistry.net
N2^++CH2O=>CH2O^++N2                       ! 3.77d-10*(Tgas/300.0d0)**-0.50d0
N2^++CH2O=>HCO^++N2+H                      ! 2.52d-09*(Tgas/300.0d0)**-0.50d0

# N3^+ reactions
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000
N3^++N=>N2^++N2                            ! 6.6d-11
N3^++O2=>O2^++N+N2                         ! 2.3d-11

# N4^+ reactions
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000
N4^++N2=>N2^++N2+N2                        ! 2.1d-16*exp(Tgas/121.0d0)
N4^++N=>N^++N2+N2                          ! 1.0d-11

#UMIST RATE12, astrochemistry.net
E+N^+=>N                                   ! 3.50d-12*(300.0d0/Te)**0.53*exp(3.2d0/Te)

# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000
E+N^++E=>N+E                               ! 7.0d-20*(300.0d0/Te)**4.5
E+N^++ANY_NEUTRAL=>N+ANY_NEUTRAL           ! 6.0d-27*(300.0d0/Te)**1.5
E+N3^+=>N2+N                               ! 2.0d-7*(300.0d0/Te)**0.50
E+N4^+=>N2+N2                              ! 2.3d-6*(300.0d0/Te)**0.53

# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
E+O2^+=>O+@B                               ! 2.7d-7*(300.0d0/Te)**0.7*@R
  @B = O       O(1D)   O(1S)
  @R = 0.55d0  0.40d0  0.05d0
E+N2^+=>N+@B                               ! 1.8d-7*(300.0d0/Te)**0.39*@R
    @B = N       N(2D)
    @R = 0.50d0  0.50d0

# Recombination reaction
# Combust. Flame 240 (2022) 111990
E+N2^+=>N(2D)+N(2D)                        ! 7.6570d-07*(300.0d0/Te)**0.39
#E+O2^+=>O+O                               ! 3.3820d-06*(300.0d0/Te)**0.70
#E+O2^+=>O+O(1D)                           ! 4.5440d-06*(300.0d0/Te)**0.70
E+O2^+=>O(1D)+O(1D)                        ! 2.0540d-06*(300.0d0/Te)**0.70
E+O2^+=>O(1D)+O(1S)                        ! 5.2830d-07*(300.0d0/Te)**0.70
E+O2^++E=>O2+E                             ! 1.0000d-25*(300.0d0/Te)**4.5
E+N2^++E=>E+N2                             ! 1.0000d-25*(300.0d0/Te)**4.5

# I.N. Kosarev, N.L. Aleksandrov, et al, Combust. Flame 156 (1) (2009) 221-233.
E+CH3OH^+=>CH3O+H                          ! 7.4d-7*(300.0d0/Te)**0.5

## Plasma assisted combustion of methane-air mixtures: Validation and reduction
N2^++O3=>O2^++O+N2                         ! 9.998d-11
N3^++O2=>O2^++N+N2                         ! 2.300d-11
N3^++N=>N2^++N2                            ! 6.600d-11
N4^++N2=>N2^++N2+N2                        ! 2.100d-16
N4^++O2=>O2^++N2+N2                        ! 2.500d-10
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000
N2^++O2=>O2^++N2                           ! 6.00d-11*(300.0d0/Tgas)**0.5

# Reactions of O2^-
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
O2^- + N => NO2 + E                        ! 5.0d-10
O2^- + O => O3 + E                         ! 1.5d-10
O2^- + O => O^- + O2                       ! 3.3d-10
O2^- + O2 => E + O2 + O2                   ! 2.7d-10*(Tgas/300.0d0)**0.5*exp(-5590.0d0/Tgas)
O2^- + O2(A1) => O2 + O2 + E               ! 2.0d-10
O2^- + O2(B1) => O2 + O2 + E               ! 3.6d-10
O2^- + N2 => O2 + N2 + E                   ! 1.9d-12*(Tgas/300.0d0)**0.5*exp(-4990.0d0/Tgas)
O2^- + N2(A) => O2 + N2 + E                ! 2.1d-9
O2^- + N2(B) => O2 + N2 + E                ! 2.5d-9

# I.A. Kossyi, et al, Plasma Sources Sci. Technol. 1 (1992) 207-220.
#O2^- + O2 + O2 => O4^- + O2               ! 3.5d-31*(300.0d0/Tgas)
# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O2^- + O(1D) => O + O2 + E                 ! 1.0d-10
O2^- + O(1S) => O + O2 + E                 ! 1.0d-10
O2^- + O(1S) => O^- + 2O                   ! 1.0d-10
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
O2^- + H => HO2 + E                        ! 1.50d-9
O2^- + H2O => O2 + H2O + E                 ! 5.0d-9*exp(-5000.0d0/Tgas)
O2^- + OH => OH^- + O2                     ! 1.00d-10
# J. Prager, et al., Proc. Combust. Inst. 31 (2007) 1129-1137.
O2^- + H => OH^- + O                       ! 1.79d-9
# A. Starikovskiy and N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
O2^- + H2 => OH + OH^-                     ! 4.0d-11

# Reactions of O^- 
# M. Capitelli, et al., Plasma Kinetics in Atmospheric Gases, Springer-Verlag, Berlin, Heidelberg, 2000.
O^- + O => O2 + E                          ! 1.4d-10
O^- + O2 => O3 + E                         ! 5.0d-15
O^- + O3 => O2 + O2 + E                    ! 3.0d-10*(300.0d0/Tgas)**0.50
O^- + N => NO + E                          ! 2.6d-10
O^- + NO => NO2 + E                        ! 2.6d-10
O^- + N2 => N2O + E                        ! 5.0d-13
#O^- + O2(A1) => O3 + E                     ! 3.0d-10
O^- + O2(A1) => O2^- + O                   ! 1.0d-10
O^- + O2(B1) => O + O2 + E                 ! 6.9d-10
O^- + N2(A) => O + N2 + E                  ! 2.2d-9
O^- + N2(B) => O + N2 + E                  ! 1.9d-9
# UMIST RATE12, astrochemistry.net.
O^- + H2 => H2O + E                        ! 7.0d-10
O^- + H => OH + E                          ! 5.0d-10
O^- + O2 => O + O2^-                       ! 7.3d-10*exp(-890.0d0/Tgas)
O^- + H2 => OH^- + H                       ! 3.0d-11
# D. Liu, et al., Plasma Process. Polym. 7 (2010) 846-865.
O^- + O3 => O2^- + O2                      ! 1.02d-11*(Tgas/300.0d0)**0.5
O^- + O(1D) => O2 + E                      ! 1.0d-10
O^- + O(1S) => O2 + E                      ! 1.0d-10
# D. Liu, et al., Plasma Sources Sci. Technol. 19 (2010) 025018 (22pp).
O^- + H2O => OH^- + OH      	           ! 1.40d-9
O^- + H2O => H2O2 + E                      ! 6.0d-13
# A. Starikovskiy and N. Aleksandrov, Mechanism of Plasma-Assisted Ignition for H2 and C1-C5 Hydrocarbons, 55th AIAA Aerospace Sciences Meeting, 2017.
O^- + OH => HO2 + E                        ! 1.0d-9
O^- + HO2 => OH + O2 + E                   ! 1.0d-9
O^- + H2O2 => H2O + O2 + E                 ! 1.0d-9

# Reactions of OH^-
# Annemie Bogaerts, Plasma Process. Polym. 2012, 9, 652-689
OH^- + O^+ => OH + O                       ! 2.0d-06*(Tgas/300.0d0)**(-0.50)
OH^- + N2^+ => OH + N2                     ! 2.0d-06*(Tgas/300.0d0)**(-0.50)
OH^- + N4^+ => OH + 2N2                    ! 1.0d-07
OH^- + H3O^+ => H2O + H2O                  ! 1.0d-07

# Reactions of H2O^+
# Annemie Bogaerts, Plasma Process. Polym. 2012, 9, 652-689
H2O^+ + H^- => H2O + H                     ! 2.0d-06*(Tgas/300.0d0)**(-0.50)
H2O^+ + O2^- => H2O + O2                   ! 2.0d-06*(Tgas/300.0d0)**(-0.50)
H2O^+ + OH^- => H2O + OH                   ! 2.0d-06*(Tgas/300.0d0)**(-0.50)
H2O^+ + O => H2 + O2^+                     ! 5.5d-11
H2O^+ + O2 => H2O + O2^+                   ! 3.3d-10
H2O^+ + H2 => H + H3O^+                    ! 1.3d-09
H2O^+ + OH => H3O^+ + O                    ! 6.9d-10
H2O^+ + H2O => H3O^+ + OH                  ! 1.7d-09

# Reactions of H^-
# Annemie Bogaerts, Plasma Process. Polym. 2012, 9, 652-689
H^- + H => e + H2                          ! 1.3d-09
H^- + O(1D) => OH + e                      ! 1.0d-09
H^- + O => e + OH                          ! 1.0d-09
H^- + O2 => HO2 + e                        ! 1.2d-09
H^- + OH => H2O + e                        ! 1.0d-10
H^- + H2O => OH^- + H2                     ! 3.8d-09

# Reactions  of H3O^+
#UMIST
H3O^+ + O2^- => O2 + H + H2O               ! 7.51d-08*(Tgas/300.0d0)**(-0.50)
H3O^+ + O^- => O + H + H2O                 ! 7.51d-08*(Tgas/300.0d0)**(-0.50)

#NIST, Kinetics and Products of the Reaction O2 with N2O, Z. Phys. Chem., 224(2010),989-1007.
O2(B1)+N2O=>NO + NO2                    ! 7.86d-14*exp(87.0d0/Tgas)
#K. Katsonis, C. Berenguer, Global Modeling of N2O Discharges: Rate Coefficients and Comparison with ICP and Glow Discharges Results
#International Journal of Aerospace Engineering, 737463 (2013)
E + N2O => E + N2 + O                     ! 3.48d-13*(Te/11605)**0.1820d0*exp(-5.25/Te/11605)
#UMIST 12
N2O => N2O^+ + E                          ! 1.70d-10*exp(-3.90/Tgas)
#UMIST 12 ESTIMATED
H2O+N2O^+=>H2O^++N2O                      ! 1.89E-10*(Tgas/300.0d0)**-0.50d0

#N. Blin-Simiand, S. Pasquiers, F. Jorand, C. Postel, J-R Vacher, J. Phys. D: Appl. Phys. 42 (2009) 122003
#S. Pasquiers, W. Faider, N. Blin-Simiand, L. Magne, P. Jeaney, F. Jorand, International Journal of Plasma Environmental Science & Technology, 6 (2012) 2.
N2(A) + CH2O => N2 + H2 + CO              ! 0.50d0*5.0d-10
N2(A) + CH2O => N2 + H + HCO              ! 0.25d0*5.0d-10
N2(A) + CH2O => N2 + H + H + CO           ! 0.25d0*5.0d-10
# estimated
N2(B) + CH2O => N2 + H2 + CO              ! 0.50d0*1.0d-09
N2(B) + CH2O => N2 + H + HCO              ! 0.25d0*1.0d-09
N2(B) + CH2O => N2 + H + H + CO           ! 0.25d0*1.0d-09
N2(a') + CH2O => N2 + H2 + CO             ! 0.50d0*1.0d-08
N2(a') + CH2O => N2 + H + HCO             ! 0.25d0*1.0d-08
N2(a') + CH2O => N2 + H + H + CO          ! 0.25d0*1.0d-08
N2(C) + CH2O => N2 + H2 + CO              ! 0.50d0*1.0d-08
N2(C) + CH2O => N2 + H + HCO              ! 0.25d0*1.0d-08
N2(C) + CH2O => N2 + H + H + CO           ! 0.25d0*1.0d-08
#estimate N2 excited reacted with N2O
N2(B) + N2O => N2 + N + NO                ! 5.0d-11
N2(C) + N2O => N2 + N + NO                ! 1.0d-10
N2(a') + N2O => N2 + N + NO               ! 5.0d-10

# J. Phys. D: Appl. Phys. 38 (2005) 4160–4167
O(1D)+CH2O=>HCO+OH                        ! 1.0d-09
N(2D)+CH2O=>HCO+NH                        ! 1.0d-09
N2(V4)+HCO=>CO+H+N2(V3)                   ! 1.0d-10
N2(V5)+HCO=>CO+H+N2(V3)                   ! 1.0d-10
N2(V6)+HCO=>CO+H+N2(V3)                   ! 1.0d-10
N2(V7)+HCO=>CO+H+N2(V3)                   ! 1.0d-10
N2(V8)+HCO=>CO+H+N2(V3)                   ! 1.0d-10
N2(A)+HCO=>CO+H+N2                        ! 1.0d-10
N2(B)+HCO=>CO+H+N2                        ! 1.0d-09
N2(C)+HCO=>CO+H+N2                        ! 1.0d-08
N2(A')+HCO=>CO+H+N2                       ! 1.0d-08
O3+HCO=>H+O2+CO2                          ! 1.0d-10

##################################################
###                CO2                         ###
##################################################
#Hayashi database
E+CO2=>CO+O^-                            ! BOLSIG CO2 -> CO + O-
E+CO2=>E+@B                              ! BOLSIG CO2 -> @R
@B = CO2     CO2     CO2     CO2     CO2
@R = CO2(V1) CO2(V2) CO2(V3) CO2(V4) CO2(V5)
E+CO2=>E+CO+O                            ! BOLSIG CO2 -> CO2*(5.7eV)
E+CO2=>E+CO+O(1D)                        ! BOLSIG CO2 -> CO2*(9.0eV)
E+CO2=>E+CO+O(1S)                        ! BOLSIG CO2 -> CO2*(11.0eV)
E+CO2=>E+CO2^++E                         ! BOLSIG CO2 -> CO2^+

# Reactions of CO2^+
# UMIST RATE12, astrochemistry.net
CO2^+ + O => O^+ + CO2                   ! 9.62d-11
CO2^+ + O => O2^+ + CO                   ! 1.64d-10
CO2^+ + O2 => O2^+ + CO2                 ! 5.30d-11
CO2^+ + H2O => H2O^+ + CO2               ! 2.04d-09*(300.0d0/Tgas)**0.50
CO2^+ + E => CO + O                      ! 3.80d-07*(300.0d0/Tgas)**0.50

# UMIST RATE12, astrochemistry.net
N2^+ + CO2 => CO2^+ + N2                 ! 7.50d-10
N^+ + CO2 => CO2^+ + N                   ! 7.50d-10


#********************************************************************************#
#                                     CO                                         #
#                      electron impact reaction                                  #
#                      IST-Lisbon database, www.lxcat.net                            #
#********************************************************************************#
E+CO=>C+O^-                              ! BOLSIG CO -> C(X) + O(-,gnd)
#E+CO=>E+CO                              ! BOLSIG CO -> CO
E+CO=>E+@B                               ! BOLSIG CO -> @R
@B = CO     CO     CO     CO     CO     CO     CO     CO     CO     CO     
@R = CO(v1) CO(v2) CO(v3) CO(v4) CO(v5) CO(v6) CO(v7) CO(v8) CO(v9) CO(v10)
E+CO=>E+@B                               ! BOLSIG CO -> @R
@B = C+O     C+O        C+O     C+O       C+O       C+O       C+O      
@R = CO(a3P) CO(a'3Su+) CO(A1P) CO(b3Su+) CO(B1Su+) CO(C1Su+) CO(E1P)
E+CO=>E+C+O                              ! BOLSIG CO -> C(X) + O(3P)
E+CO=>E+E+CO^+                           ! BOLSIG CO -> CO(+,X)

#UMIST 
CO^++CO2=>CO2^++CO                       ! 1.00d-09
CO^++O2=>O2^++CO                         ! 1.20d-10
CO^++H2O=>H2O^++CO                       ! 1.72d-09*(Tgas/300.0d0)**-0.50d0
CO^++O=>O^++CO                           ! 1.40d-10
CO^++E=>C+O                              ! 2.00d-07*(Tgas/300.0d0)**-0.48d0

N^++CO2=>CO^++NO                         ! 2.50d-10
CO+N2^+=>CO^++N2                         ! 7.40d-11
C+O2^+=>CO^++O                           ! 5.20d-11


END 

