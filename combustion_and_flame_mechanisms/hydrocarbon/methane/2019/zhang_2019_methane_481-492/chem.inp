!C0
 AR        N2          H          H2         HE
 O         OH          H2O        HO2        H2O2       O2                                    

!C1                                                     
 C         CH          CH2        CH2*       CH3        CH4         
 CO        CO2         HCO		  CH2O       HCOH
 CH2OH     CH3O        CH3OH
       
!C2                                                     
 C2H       C2H2        H2CC       HCCOH      C2H3       C2H4     C2H5      C2H6                                                         
 C2O       HCCO        CH2CO      CH3CO      CH2CHO     CH3CHO                
 C2H5O     C2H3OH      HCCHOH     CH2COH                     

 C3H3
 
END


