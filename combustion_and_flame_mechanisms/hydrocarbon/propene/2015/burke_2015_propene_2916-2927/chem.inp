! reaction class 24:  qooh = alkene + ho2 (radical site beta to ooh group)

!  rate rules from sarathy et al. 2-methyl-alkanes, comb. flame. 2011
!  rate specified by the reverse rate as an ho2 addition to the double bond
!  no adjustment was made for o atom substitutions on the double bond

tpgme4d + ho2 = tpgme-3ooh-4    1.00e11 0.00 1.190e4 
tpgme4d + ho2 = tpgme-4ooh-3    1.00e11 0.00 1.190e4
tpgme3d + ho2 = tpgme-5ooh-3    1.00e11 0.00 1.190e4
tpgme8d + ho2 = tpgme-7ooh-8    1.00e11 0.00 1.190e4
