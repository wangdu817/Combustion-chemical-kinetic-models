! reaction class 22:  ro decomposition
! wjp: rule: 7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008

tpgme-1o => ccjcpg + ch2o + ch3cho + ch2o 7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
! decompose in 2 steps to avoid more than 4 products:
!ccjcpg = c3h6 + ch3cho + ch2oh      1.00e+12  0.5 28000.0 ! wjp: average r decomp based on curran 2008
tpgme-3o => me + ch2o + ccjcpg                            7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
tpgme-4o => ch2o + c2h3och3 + pgcc(c)oj                   7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
tpgme-5o => ch3o-sc2h4cho + pgcc(c)oj                     7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
tpgme-7o => o*c(c)coc(c)coh + ch2o + ch3cho + ch3         7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
tpgme-8o => ccjcpg + ch2o + ch3cho + ch2o                 7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
                                                         ! makes ch3cho+ch2oh => use the same produces as tpgme-1o
!tpgme-9o => o*coc[c]coh + ch3cho + c3h6 + ch3o            7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
tpgme-9o  => hocc*oc + ch2o + ch3cho + c3h6 + ch3o         7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
!                                                        avoid formation of new species o*coc[c]coh, use tpgme-11o products which has similar products
tpgme-11o => hocc*oc + ch2o + ch3cho + c3h6 + ch3o       7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
tpgme-12o => ch2o + hoch2cho + c3h6 + ch2o + ch3cho + ch3 7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008
tpgme-13o => hocho + ch3cho + c3h6 + ch2o + ch3cho + ch3  7.00e+21 -2.5 1.60e+04 ! wjp: average ro decomp based on curran 2008

