tpgme8d + ho2 = tpgme-8ooh-7    1.00e11 0.00 1.190e4
tpgme7d + ho2 = tpgme-9ooh-7    1.00e11 0.00 1.190e4
tpgme12d + ho2 = tpgme-11ooh-12 1.00e11 0.00 1.190e4
