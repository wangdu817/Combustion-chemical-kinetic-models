!
! tpgme high temperature reactions
! (uf= uncertainty factor for rate constant.)

!initiation
! break between 2 & 3 position: (use 6&7 position rate)
!tpgme = ch3o + c3h6 + pgcc(c)oj
! break between 3 & 4 position: 
tpgme => ch3 + c2h3och3 + pgcc(c)oj  4.0e+027 -3.11 9.2e+04  !iso-butanol, sarathy et al. 2012
! break between 3 & 5 position: 
tpgme => ch3cho + ch3 + ch2o + ccjcpg 9.50e+23 -2.00 8.80e+04 ! wjp: ave c-c bond breaking in large alkane
! break between 5&6 position:
cocc2j + pgcc(c)oj = tpgme 1.2e13 0.0 0.0 ! based on ch3o+ch3=ch3och3 tsang&hampson 1986 
! break between 6&7 position:
cocc2oj + ccjcpg   = tpgme 1.2e13 0.0 0.0 ! based on ch3o+ch3=ch3och3 tsang&hampson 1986 
! break between 7 & 8 position:
!tpgme = ch3 + ... 4.0e+027 -3.11 9.2e+04  !iso-butanol, sarathy et al. 2012
! break between 7 & 9 position:
tpgme => ch2o + c3h6 + oh + ch3cho + c3h6 + ch3o 9.50e+23 -2.00 8.80e+04 ! wjp: ave c-c bond breaking in large alkane
! break between 9 & 10 position:(use rate from 5&6)
! tpgme = ch3cho + ch2oh + c3h6 + ch2o + ch3cho + ch3o
! break between 10 & 11 position:(use rate from 6&7)
! tpgme = c3h6 + oh + ch2o + ch3cho + c3h6 + ch3o
! break between 11 & 12 position:
tpgme => ch3 + hoch2cho + c3h6 + ch2o + ch3cho + ch3 4.0e+027 -3.11 9.2e+04  !iso-butanol, sarathy et al. 2012
! break between 11 & 13 position:(use rate from isopentanol)
tpgme => ch2oh + ch3cho + c3h6 + ch2o + ch3cho + ch3 3.3e+25 -2.41 8.80e+04 !iso-butanol, sarathy et al. 2012


!molecular elimination
! Reaction rate constant nearly identical to that of MTBE from Brocard, J.C.Baronnet, F., J. Chim. Phys. Phys. Chim. Biol. 84, 1987
tpgme = dpgcc*c + ch3oh  1.19e+13 0.19 58420.0 !mtbe=ic4h8+ch3oh x 5/9 because only 5 h's are involved.  Products are lumped for all possible rxn with no. 2 o
tpgme = cocc2oh + pgcc*c 1.43e+13 0.19 58420.0 !mtbe=ic4h8+ch3oh x 6/9 because only 6 h's are involved.  Products are lumped for all possible rxn with no. 3 o
tpgme = dpgme + ac3h5oh   1.43e+13 0.19 58420.0 !mtbe=ic4h8+ch3oh x 6/9 because only 6 h's are involved. Products are lumped for all possible rxn with no. 3 o; ac3h5oh species is lumped

!reaction with o2
! deg = degeneracy
! f = proportionality factor to be used in evans-polanyi relationship from dean and bozzelli, 1997
tpgme + o2 = tpgme-1  + ho2 2.0e+13   0.00 44910.0    ! assume 1/2 of dme rate, saudi aramco mech 1.3
tpgme + o2 = tpgme-3  + ho2 6.7e+12   0.00 39910.0    ! assume dme rate, corrected for tertiary, deg=1 => 101.2-96.2=5 kcal. assume f=1.  
tpgme + o2 = tpgme-4  + ho2 3.0e13    0.00 49640.0    ! primary reaction rate rule from sarathy et al. 2011, deg=3
tpgme + o2 = tpgme-5  + ho2 1.3e+13   0.00 41610.0    ! assume dme rate, corrected for secondary, deg=2. 101.2-97.9=3.3 kcal. assume f=1.
tpgme + o2 = tpgme-7  + ho2 6.7e+12   0.00 39910.0    ! assume dme rate, corrected for tertiary, deg=1 => 101.2-96.2=5 kcal. assume f=1.
tpgme + o2 = tpgme-8  + ho2 3.0e13    0.00 49640.0    ! primary reaction rate rule from sarathy et al. 2011, deg=3
tpgme + o2 = tpgme-9  + ho2 1.3e+13   0.00 41610.0    ! assume dme rate, corrected for secondary, deg=2. 101.2-97.9=3.3 kcal. assume f=1.
tpgme + o2 = tpgme-11 + ho2 6.7e+12   0.00 39910.0    ! assume dme rate, corrected for tertiary, deg=1 => 101.2-96.2=5 kcal. assume f=1.
tpgme + o2 = tpgme-12 + ho2 3.0e13    0.00 49640.0    ! primary reaction rate rule from sarathy et al. 2011, deg=3
tpgme + o2 = tpgme-13 + ho2 1.3e+13   0.00 41610.0    ! assume dme rate, corrected for secondary, deg=2. 101.2-97.9=3.3 kcal. assume f=1.


!h atom abstraction 
! note: primary c-hs in ethers are expected to have bond strengths 1 +/- 0.2 kcal higher than primary chs in alkanes (based on bds from chen & bozzelli, ethers, jpca 2003, 107,4531 
! and yasunaga et al. butanol, cnf2012.  this is neglected and alkane rates are used.

! oh rates, uf=2
