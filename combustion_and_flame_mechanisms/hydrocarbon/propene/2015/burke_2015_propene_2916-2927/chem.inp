! allyl primary hs abstracted, deg=3
tc3h5och3 + o2 => c3h4-a + ch3o + ho2               3.000e+13  0.00  3.910e+04       !  saudi aramco mech 1.3 (no reference)
tc3h5och3 + oh => c3h4-a + ch3o + h2o               3.12e+06 2 -298.00               ! assume  same as allylic h, curran et al, n-heptane, c&f 114:149 (1998)
tc3h5och3 + h => c3h4-a + ch3o + h2                 1.73e+05 2.5 2492.00             ! assume  same as allylic h, curran et al, n-heptane, c&f 114:149 (1998)
tc3h5och3 + ch3 => c3h4-a + ch3o + ch4              2.21e+00 3.5 5675.00             ! assume  same as allylic h, curran et al, n-heptane, c&f 114:149 (1998)
tc3h5och3 + ch3o2 => c3h4-a + ch3o + ch3o2h         2.21e+00 3.5 5675.00             ! assume  same as allylic h, curran et al, n-heptane, c&f 114:149 (1998)
tc3h5och3 + ch3o => c3h4-a + ch3o + ch3oh           2.21e+00 3.5 5675.00             ! assume  same as allylic h, curran et al, n-heptane, c&f 114:149 (1998)

! ether primary hs abstracted, deg=3.  use 1/2 of dimethylether rate from saudi aramco mech 1.3
tc3h5och3 + o2 => ch2o + c3h5-t + ho2               2.0e+13     0.00  44910.0        ! no ref in saudi aramco mech
tc3h5och3 + oh => ch2o + c3h5-t + h2o               3.2e+06     2.00    -651.7       ! arif m, et al., j. phys. chem. a, 101, 13, 2436-2441 (1997).
tc3h5och3 + h => ch2o + c3h5-t + h2                 3.9e+06     2.09    3384.0       ! curran, fit to nist database
tc3h5och3 + ch3 => ch2o + c3h5-t + ch4              7.2e-07     5.73    5700.0       ! no ref in saudi aramco mech
tc3h5och3 + ch3o2 => ch2o + c3h5-t + ch3o2h         1.56e+02     3.12   13190.0 
tc3h5och3 + ch3o => ch2o + c3h5-t + ch3oh           3.0e+011     0.00    4074.0      !estimate

! pgmetc3h5
! consider abstraction of primary allylic chs and primary ether hs:
! abstraction of primary allylic hs, deg=3:
pgmetc3h5 + o2 => cocc2oj + c3h4-a + ho2            3.000e+13  0.00  3.910e+04       !  saudi aramco mech 1.3 (no reference)
pgmetc3h5 + oh => cocc2oj + c3h4-a + h2o            3.1e+06   2.0   -298.0           !  tsang 1991  
pgmetc3h5 + h => cocc2oj + c3h4-a + h2              1.73e+05  2.50   2492.0          !  tsang 1991)
pgmetc3h5 + o => cocc2oj + c3h4-a + oh              1.75e12   0.70   5884.0          !  tsang 1991
pgmetc3h5 + ch3 => cocc2oj + c3h4-a + ch4           2.21      3.5    5675.0          ! tsang, propene, 1991              
pgmetc3h5 + ch3o2 => cocc2oj + c3h4-a + ch3o2h      9.6e+03   2.6    1.39e+04        ! use ho2 abstraction rate constant             
pgmetc3h5 + ch3o => cocc2oj + c3h4-a + ch3oh        8.3e10 0.0 2600.0                !! used secondary alkyl h rate for n-alkane+ch3o,
      ! reduced ea by difference between bd for seconary alkyl and primary allylic with f=.2: 0.2(98.4-88.2)=.2*10.2=2.0 
      !est. f is larger than oh which is 0.1.  reduced a factor by 2.6 for tying up rotor (used scott and walkers, c&f2002 a-factors to get 2.6)

!abstraction of primary ether hs,deg=3 (use 1/2 of dme rate):
! the t-allyloxy formed is reasonantly stablized and ch3coch2 is the more stable form
pgmetc3h5 + o2 => ch2o + c3h6 + ch3coch2 + ho2         4.1e+13   0.00 44910.0    ! saudi aramco mech 1.3                                                             
pgmetc3h5 + oh => ch2o + c3h6 + ch3coch2 + h2o         3.2e+06   2.00  -651.7    ! saudi aramco mech 1.3, arif m, et al., j. phys. chem. a, 101, 13, 2436-2441 (1997 
pgmetc3h5 + h => ch2o + c3h6 + ch3coch2 + h2           3.9e+06   2.09  3384.0    ! saudi aramco mech 1.3, curran fit to nist database                                
pgmetc3h5 + o => ch2o + c3h6 + ch3coch2 + oh           3.9e+08   1.36  2250.0    ! saudi aramco mech 1.3, curran fit to nist database                                
pgmetc3h5 + ho2 => ch2o + c3h6 + ch3coch2 + h2o2       4.3e+02   3.01 12090.0    ! saudi aramco mech 1.3, based on j. aguilera-iparraguirre et al 2008               
