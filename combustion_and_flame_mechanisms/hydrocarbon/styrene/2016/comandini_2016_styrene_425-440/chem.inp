!rev/ 1.046e+14 -0.84 3.487e+04 /

!direction change
!hoch2o2h = hoch2o+oh 1.023e+21 -1.92 4.249e+04
!rev/ 1.000e+13 0.00 0.000e+00 /
hoch2o+oh = hoch2o2h 1.000e+13 0.00 0.000e+00 

