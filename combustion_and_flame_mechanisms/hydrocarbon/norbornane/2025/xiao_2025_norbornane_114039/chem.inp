REACTIONS
!#########################################################################################################################
!                                              submechanism of norbornane(cCH2cC6H10)                                    #
!#########################################################################################################################

!***************************************** C-C bond dissociation reactions ********************************************************
cCH2cC6H10 = PXCH2S4XcC6H10                        		4.36E+11  	0.754      78970.0         ! Refer to NBN = BR3 *1/100 in this work
cCH2cC6H10 = PXC2H4S3XcC5H8                        		3.90E+12  	0.835      81790.0         ! Refer to NBN = BR2 *1/50 in this work

!***************************************** C-H bond dissociation reactions *********************************************************


!***************************************** H-abstraction reactions ******************************************************************
cCH2cC6H10+H = cCH2TXC6H9+H2                       		2.40E+08  	1.50       11700.0         ! Refer to NBN+H = R1+H2 *1/2 in this work
cCH2cC6H10+H = cCHC6H10+H2                        		4.80E+08  	1.50        7140.0         ! Refer to NBN+H = R2+H2
cCH2cC6H10+H = cCH2C6H9+H2                         		7.68E+08  	1.50        5750.0         ! Refer to NBN+H = R3+H2 *2/5 in this work
cCH2cC6H10+CH3 = cCH2TXC6H9+CH4                    		1.62E+06  	1.87       14760.0         ! Refer to NBN+CH3 = R1+CH4
cCH2cC6H10+CH3 = cCHC6H10+CH4                      		1.62E+06  	1.87       13000.0         ! Refer to NBN+CH3 = R2+CH4
cCH2cC6H10+CH3 = cCH2C6H9+CH4                      		2.59E+07  	1.87        8780.0         ! Refer to NBN+CH3 = R3+CH4 *4 in this work

!***************************************** Radical beta-scission reactions **********************************************************


!****************************************** Radical isomerization reactions *****************************************************************
! reactions of BR3
PXCH2S4XcC6H10 = CH2cC6H10                         		1.90E+10  	1.000      10100.0         ! Refer to BR3 = MA6
PXCH2S4XcC6H10 = CH3-4-cC6H9                       		3.80E+10  	1.000       7800.0         ! Refer to BR3 = MA5
! reactions of BR2
PXC2H4S3XcC5H8 = C2H5-3-cC5H7                      		6.60E+08  	1.000       3600.0         ! Refer to BR2 = MA4 *1/5 in this work
PXC2H4S3XcC5H8 = C2H5-4-cC5H7                      		1.15E+09  	1.000       5400.0         ! Refer to BR2 = MA3 *1/2 in this work
PXC2H4S3XcC5H8 = C2H3cC5H9                         		3.30E+09  	1.000       8200.0         ! Refer to BR2 = MA2
! reactions of R1
cCH2TXC6H9 = CH2S3XcC6H9                           		6.76E+12  	0.366      26000.0         ! Refer to NBN: R1 = R4
! reactions of R2
cCHC6H10 = PXCH2CH2-3-cC5H7                        		7.41E+12  	0.492      24940.0         ! Refer to NBN: R2 = R6
! reactions of R3
cCH2C6H9 = PXCH2CH2-4-cC5H7                        		4.79E+12    0.380      23740.0         ! NBN: R3=R7
cCH2C6H9 = PXCH2-4-cC6H9                           		5.89E+12    0.270      27700.0         ! NBN: R3=R8
cCH2C6H9 = C2H3-1-S3XcC5H8                         		1.55E+12    0.397      34480.0         ! NBN: R3=R9


