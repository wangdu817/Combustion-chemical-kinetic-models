!**********************************************************************!
!**********************************************************************!
!*             Primary mechanism of the oxidation of indane           *!
!**********************************************************************!
!**********************************************************************!

!****************************************************!
!* Reactions of indane                                 *!
!****************************************************!

!**unimolecular initiation
!*rupture of C-C and C-H
indane=>CH3styre       1.26E16   0.0  84.9E3  ! Est.!W.Tsang,Int.J.Chem.Kin.10(1978)599-617

! by analogy with c-C5H10 TSA78!
R1H+indanyl-Y=indane      1.0E14    0.0  0.0  ! Est.R1H+C5H7#Y=C5H8#
R1H+indanyl-1=indane      1.0E14    0.0  0.0  ! Est.R1H+C5H7#=C5H8#

!**bimolecular initiation
indane+O2=indanyl-Y+R3OOH   2.8E12  0.0  35.96E3 ! Est.C5H8#+O2=C5H7#Y+HO2 A*2 delta H cal
indane+O2=indanyl-1+R3OOH   1.4E13  0.0  45.46E3 ! Est.C5H8#+O2=C5H7#+HO2 delta H cal

!**ipso-additions
indane+R1H=ph#C3H6-1      2.32E14  0.0  8.1E3   !nBB A*4
indane+R4CH3=CH3C6H4C3H6  2.4E12   0.0  15.9E3  !ph#C4H9+R4CH3=toluene+R20C4H9!A*2
indane+B1O=>C6H5O#+RC3H5Y   1.7E13  -0.15  3.6E3  !toluene+O Tsang 1989

!**metatheses
!*metatheses with abstraction of H-atom
indane+R1H=indanyl-Y+H2     1.08E5   2.5   -1.9E3   !Est.!C5H8#+R1H=C5H7#Y+H2
indane+R1H=indanyl-1+H2     9.0E6    2.0    5.0E3   !Est.!C5H8#+R1H=C5H7#+H2

indane+B1O=indanyl-Y+R2OH   1.7E11   0.7   3.25E3   !Est.!C5H8#+O=C5H7#Y+OH
indane+B1O=indanyl-1+R2OH   2.6E13   0.0   5.2E3    !Est.!C5H8#+O=C5H7#+OH


indane+R2OH=indanyl-Y+H2O   6.0E6   2.0   -1.52E3  !Est.!C5H8#+OH=C5H7#Y+H2O
indane+R2OH=indanyl-1+H2O   2.6E6   2.0   -0.77E3  !Est.!C5H8#+OH=C5H7#+H2O

indane+R3OOH=indanyl-Y+H2O2  1.28E04  2.6   12.4E3  !Est.!ph#C4H9+R3OOH=ph#C4H8X+H2O2
indane+R3OOH=indanyl-1+H2O2  4.0E11   0.0   15.5E3  !Est.!ph#C4H9+R3OOH=ph#C4H8-3+H2O2	

indane+R4CH3=indanyl-Y+CH4   2.0E11  0.0  7.3E3   !Est.!C5H8#+CH3=C5H7#Y+CH4
indane+R4CH3=indanyl-1+CH4   2.0E11  0.0  9.6E3   !Est.!C5H8#+CH3=C5H7#+CH4

indane+C6H5#=indanyl-Y+C6H6#   8E12  0.0  8.0E3 !Est.!toluene+C2H3#=benzyl+C2H4# A*2
indane+benzyl=indanyl-Y+toluene 8.8E12  0.0  13.1E3!Est.!ph#C4H9+benzyl=ph#C4H8X+toluene A*2*4

!*******************************************************!
!* Reactions of indanyl-Y      c(#1)&c(#2)&ch&ch&ch&ch&1,1/CH(.)/CH2/CH2/2    *!
!*******************************************************!

!**bete-scission decomposition
indanyl-Y=C2H3C6H4CH2         1.36E12   0.440  41.33E3  !cal.
indanyl-Y=indene+R1H          1.21E11   0.985   42.2E3  !Cal.

!**combinations
indanyl-Y+R3OOH=>C9H9O#+R2OH   1.0E13   0.0   0.0   !Est.! Ph#C4H8X+R3OOH  A*2
indanyl-Y+B1O=C9H9O#           1.16E14  -0.02  0.02E3!indenyl+B1O=C9H7O#  A*2
indanyl-Y+R4CH3=methylindane     1.0E13   0.0   0.0   !Est.!C5H5#+R4CH3=MCPD A*2
indanyl-Y+benzyl=toluene+indene   1.0E13   0.0   0.0   !ph#C4H8X+benzyl=toluene+ph#C4H7-3 A*2
indanyl-Y+R1H=indene+H2           1.8E13   0.0   0.0   !Est.C5H7#Y+R1H=C5H6#+H2
indanyl-Y+R2OH=indene+H2O         6.0E12   0.0   0.0   !Est.C5H7#Y+R2OH=C5H6#+H2O
indanyl-Y+indanyl-Y=indene+indane   5.0E12   0.0   0.0   !Est.
indanyl-Y+indenyl=2indene         5.0E12   0.0   0.0   !Est.

!**oxidation
indanyl-Y+O2=indene+R3OOH     1.58E12  0.0  15.2E3 !Est.!similar to C5H7#Y+O2=C5H6#+R3OOH A*2

!**isomerization
indanyl-1=indanyl-Y     1.95E10   1.0   34.2E3   !Est.!similar to ph#C4H8-3=ph#C4H8X

